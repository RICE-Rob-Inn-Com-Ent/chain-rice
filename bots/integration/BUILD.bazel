load("@rules_python//python:defs.bzl", "py_library", "py_test")

# Hugging Face integration
py_library(
    name = "huggingface",
    srcs = ["huggingface.py"],
    deps = [
        "@pypi_requests//:pkg",
        "@pypi_huggingface_hub//:pkg",
    ],
    visibility = ["//visibility:public"],
)

# OpenAI integration  
py_library(
    name = "openai",
    srcs = ["openai.py"],
    deps = [
        "@pypi_openai//:pkg",
        "@pypi_requests//:pkg",
    ],
    visibility = ["//visibility:public"],
)

# Test for integrations
py_test(
    name = "test_huggingface",
    srcs = ["test_huggingface.py"],
    deps = [":huggingface"],
    visibility = ["//visibility:public"],
)

py_test(
    name = "test_openai", 
    srcs = ["test_openai.py"],
    deps = [":openai"],
    visibility = ["//visibility:public"],
)
