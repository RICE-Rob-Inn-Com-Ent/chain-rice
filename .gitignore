# ==============================================================================
# RICE-MONO .GITIGNORE
# ==============================================================================
# Enterprise monorepo gitignore patterns
# Excludes build artifacts, dependencies, IDE files, secrets, and OS files
# ==============================================================================

# ============================================================================
# DEPENDENCIES
# ============================================================================
# Node.js
node_modules/
.pnp/
.pnp.js

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
.Python
*.egg-info/
dist/
build/
*.egg

# Rust
target/
Cargo.lock
**/*.rs.bk

# Go
/vendor/

# Ruby
/.bundle/
/vendor/bundle

# ============================================================================
# BUILD OUTPUTS
# ============================================================================
# Bazel
bazel-*
/bazel-bin/
/bazel-out/
/bazel-testlogs/

# General build directories
dist/
build/
out/
*.o
*.so
*.dylib
*.dll
*.exe

# Frontend frameworks
.next/
.nuxt/
.angular/
.svelte-kit/
.cache/

# Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
*.g.dart

# Android
*.apk
*.ap_
*.aab
*.dex
*.class
bin/
gen/
local.properties
.gradle/
gradle-app.setting

# iOS
*.ipa
*.dSYM.zip
*.dSYM
DerivedData/
*.hmap
*.ipa
*.xcuserstate
*.xcworkspace/
!default.xcworkspace
.build/
.swiftpm/

# ============================================================================
# TESTING & COVERAGE
# ============================================================================
coverage/
.nyc_output/
*.lcov
htmlcov/
.tox/
.coverage
.coverage.*
.pytest_cache/
.hypothesis/
junit.xml
test-results/

# ============================================================================
# IDE & EDITORS
# ============================================================================
# VS Code
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
.vscode/.ropeproject

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim
*.swp
*.swo
*~
.*.sw?

# Emacs
*~
\#*\#
.\#*

# JetBrains
.idea/
*.iml
out/

# ============================================================================
# OS FILES
# ============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*

# ============================================================================
# LOGS & TEMPORARY FILES
# ============================================================================
*.log
logs/
*.tmp
*.temp
tmp/
temp/
*.pid
*.seed
*.pid.lock

# ============================================================================
# ENVIRONMENT & SECRETS
# ============================================================================
.env
.env.local
.env.*.local
.envrc.local
*.pem
*.key
*.cert
*.crt
id_rsa
id_rsa.pub
*.p12
*.pfx

# ============================================================================
# CACHES
# ============================================================================
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# ============================================================================
# DOCKER & KUBERNETES
# ============================================================================
docker-compose.override.yml
.dockerignore.local

# ============================================================================
# TERRAFORM
# ============================================================================
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!example.tfvars
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ============================================================================
# DATABASE
# ============================================================================
*.db
*.sqlite
*.sqlite3

# ============================================================================
# PACKAGE MANAGER SPECIFIC
# ============================================================================
# npm
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# pnpm
.pnpm-debug.log*

# yarn
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# ============================================================================
# GENERATED FILES
# ============================================================================
# Protocol Buffers
*_pb2.py
*_pb2_grpc.py
*.pb.go
*_pb.js
*_pb.ts

# GraphQL
*.generated.ts
*.generated.js

# ============================================================================
# MONOREPO SPECIFIC
# ============================================================================
# Version manager
.nvmrc.local
.python-version.local

# User-specific Bazel config
.bazelrc.user
.bazelrc.local

# User-specific configs
.local/
local/

# Project slot - contains active project (has its own .git)
# NOTE: .project/ is a dynamic slot that changes between projects.
#       Each project is a separate git repo, so git automatically ignores it.
#       Keep .instructions.md and .vscode/ template for onboarding.
!.project/.instructions.md
!.project/.vscode/
.project/.vscode/settings.json

# Project management
.project-cache/
.project-active
# .project-repos.json - commit this file!

# ============================================================================
# SECURITY SCANNING
# ============================================================================
# Don't ignore the baseline - we want to track it
# .secrets.baseline

# ============================================================================
# DOCUMENTATION BUILDS
# ============================================================================
site/
docs/_build/
docs/.doctrees/

# ============================================================================
# BLOCKCHAIN (Cosmos SDK / Ignite)
# ============================================================================
# Ignite CLI
*.ign

# Blockchain releases
release/

# Graph/diagram files
*.dot

# Vue frontend (if using ignite scaffold vue)
vue/node_modules
vue/dist

# ============================================================================
# MISC
# ============================================================================
*.bak
*.backup
*.orig
*.rej
.vscode-test

# ==============================================================================
# END OF .GITIGNORE
# ==============================================================================
