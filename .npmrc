# ==============================================================================
# NPM CONFIGURATION - Rice Monorepo
# ==============================================================================
# Enterprise-grade npm settings for security, performance, and consistency
# ==============================================================================

# ============================================================================
# PACKAGE MANAGEMENT
# ============================================================================
# Use exact versions (no ^ or ~)
save-exact=true

# Always save to package.json when installing
save=true

# Engine strict mode (enforce Node.js/npm versions)
engine-strict=true

# Package lock
package-lock=true

# ============================================================================
# SECURITY
# ============================================================================
# Audit automatically on install
audit=true
audit-level=moderate

# Prevent scripts from running with sudo
unsafe-perm=false

# Only download packages over HTTPS
https-only=true

# ============================================================================
# PERFORMANCE
# ============================================================================
# Prefer offline installation
prefer-offline=true

# Max network request attempts
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Progress bar (disable in CI)
progress=true

# ============================================================================
# REGISTRY
# ============================================================================
# Use npm registry (or configure your private registry)
registry=https://registry.npmjs.org/

# Scoped packages (if using private registry)
# @company:registry=https://npm.company.internal/

# ============================================================================
# LOGGING
# ============================================================================
# Log level: silent, error, warn, notice, http, timing, info, verbose, silly
loglevel=warn

# ============================================================================
# MISCELLANEOUS
# ============================================================================
# Update notifier (disable in CI)
update-notifier=true

# Fund messages
fund=false

# Workspaces (for monorepo)
workspaces=true

# Legacy peer deps (for compatibility)
legacy-peer-deps=false

# ============================================================================
# CACHE
# ============================================================================
# Cache directory
cache=${HOME}/.npm

# Cache verification
cache-min=10

# ============================================================================
# DEVELOPMENT
# ============================================================================
# Development mode
# production=false
