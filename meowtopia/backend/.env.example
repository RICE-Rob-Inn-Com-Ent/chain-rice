# Production Environment Variables for Meowtopia Backend
# Copy this file to .env and modify values for your environment

# Application Configuration
DEBUG=true
APP_NAME="Meowtopia Backend API"
APP_VERSION="1.0.0"

# Security Configuration - IMPORTANT: Change these values!
SECRET_KEY=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1
MIN_PASSWORD_LENGTH=8

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:your_db_password@db:5432/meowtopia
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=3600

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://meowtopia.app,https://game.meowtopia.app

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=100

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=true
FROM_EMAIL=noreply@meowtopia.app

# OpenAI Configuration (Optional)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=1000

# Sentry Configuration (Optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=/app/uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Worker Configuration
WORKER_CONNECTIONS=1000
MAX_WORKERS=4
KEEP_ALIVE=2

# Health Check
HEALTH_CHECK_INTERVAL=30

# Blockchain Integration
CHAIN_RICE_RPC_URL=http://localhost:26657
CHAIN_RICE_API_URL=http://localhost:1317
CHAIN_RICE_GRPC_URL=http://localhost:9090

# Game Configuration
GAME_ECONOMY_FACTOR=1.0
MAX_CATS_PER_USER=100
DAILY_REWARD_AMOUNT=100
