{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "strict": true,
    "strictNullChecks": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "esModuleInterop": true,
    "typeRoots": ["node_modules/@types"],
    "allowJs": true,
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["src/*"],
    },
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/**/*", "vite.config.ts", "src/index.tsx", "vite-env.d.ts", "src/app/services", "src/app/services/indexedDB/components"]
}
