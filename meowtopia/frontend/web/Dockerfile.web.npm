# 🌐 Multi-platform Node.js Dockerfile using npm (fallback for Yarn issues)
FROM --platform=$BUILDPLATFORM node:18-slim

# 📁 Set working directory
WORKDIR /app

# 🧹 Clean any existing installations
RUN rm -rf node_modules package-lock.json

# 📦 Copy package files first
COPY package.json ./

# 🔧 Install dependencies with npm (more stable for cross-platform)
RUN npm install --legacy-peer-deps || \
    (echo "First install failed, trying with force..." && \
     rm -rf node_modules package-lock.json && \
     npm install --legacy-peer-deps --force)

# 📦 Copy package-lock.json if it exists
COPY package-lock.json* ./

# 🔄 Final install to ensure consistency
RUN npm install --legacy-peer-deps || \
    npm install --legacy-peer-deps --force

# 📦 Copy the full frontend codebase
COPY . .

# 🚪 Expose the Vite dev server port
EXPOSE 3000

# 🧪 Set default env
ENV NODE_ENV=development

# 🚀 Start the Vite development server using npm
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]
