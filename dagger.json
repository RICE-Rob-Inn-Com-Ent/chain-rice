{
  "name": "rice",
  "engineVersion": "v0.15.3",
  "sdk": "go",
  "source": "service/ci/",
  "include": [
    "base/",
    "service/",
    "frontend/",
    "function/",
    "infra/",
    "custom/",
    "justfile",
    ".buckconfig",
    "pixi.toml",
    "pixi.lock"
  ],
  "exclude": [
    "buck-out/",
    ".buck-cache/",
    "node_modules/",
    "__pycache__/",
    ".dart_tool/",
    "_build/",
    "deps/",
    ".pixi/",
    "*.enc.env",
    ".rice-model",
    ".rice-hardware.json",
    ".rice-compute.json"
  ],
  "dependencies": [
    {
      "name": "golang",
      "source": "github.com/dagger/dagger/modules/golang@v0.15.3"
    },
    {
      "name": "python",
      "source": "github.com/dagger/dagger/modules/python@v0.15.3"
    },
    {
      "name": "docker",
      "source": "github.com/dagger/dagger/modules/docker@v0.15.3"
    }
  ]
}
