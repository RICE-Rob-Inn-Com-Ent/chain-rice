{
  "folders": [
    {
      "name": "🌍ROOT",
      "path": "."
    },
    {
      "name": "🤖BOT",
      "path": "bots"
    },
    {
      "name": "🛠️TOOL",
      "path": "tools"
    },
    {
      "name": "⚙️BACKEND",
      "path": "libs/backend"
    },
    {
      "name": "🔗CONNECTION",
      "path": "libs/connection"
    },
    {
      "name": "📄CONTRACT",
      "path": "libs/contract"
    },
    {
      "name": "🎨FRONTEND",
      "path": "libs/frontend"
    },
    {
      "name": "📦PROTOTYPE",
      "path": "libs/proto"
    },
    {
      "name": "🍚ChainRice",
      "path": "projects/chain-rice/"
    },
    {
      "name": "🐱Meowtopia",
      "path": "projects/meowtopia/"
    }
  ],
  "settings": {
    "typescript.preferences.importModuleSpecifier": "relative",
    "typescript.suggest.autoImports": true,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    },
    "files.associations": {
      "*.proto": "proto3",
      "Dockerfile.*": "dockerfile"
    },
    "protoc": {
      "path": "/usr/local/bin/protoc",
      "compile_on_save": true,
      "options": [
        "--proto_path=${workspaceFolder}/apps/chain-rice/contracts/proto",
        "--go_out=${workspaceFolder}/apps/chain-rice/backend/go/pkg/proto",
        "--go-grpc_out=${workspaceFolder}/apps/chain-rice/backend/go/pkg/proto"
      ]
    },
    "go.toolsManagement.checkForUpdates": "local",
    "go.useLanguageServer": true,
    "go.gopath": "${env:HOME}/go",
    "go.goroot": "/usr/local/go",
    "go.gocache": "${env:HOME}/.cache/go-build",
    "go.gomodcache": "${env:HOME}/go/pkg/mod",
    "python.defaultInterpreterPath": "/usr/bin/python3",
    "python.terminal.activateEnvironment": true,
    "python.linting.enabled": true,
    "python.linting.pylintEnabled": false,
    "python.linting.flake8Enabled": true,
    "python.formatting.provider": "black",
    "files.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true,
      "**/.git": true,
      "**/.DS_Store": true,
      "**/__pycache__": true,
      "**/*.pyc": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true,
      "**/.git": true,
      "**/chain-data": true
    },
    "terminal.integrated.cwd": "${workspaceFolder}",
    "workbench.colorTheme": "Default Dark+",
    "workbench.iconTheme": "material-icon-theme",
    "ocaml.sandbox": {
      "kind": "dune",
      "root": "${workspaceFolder:🧑‍💻Dev|🌍Root}/stacks"
    },
    "files.watcherExclude": {
      "**/target": true
    }
  },
  "extensions": {
    "recommendations": [
      "ms-vscode.vscode-typescript-next",
      "bradlc.vscode-tailwindcss",
      "esbenp.prettier-vscode",
      "ms-vscode.vscode-eslint",
      "golang.go",
      "ms-python.python",
      "ms-python.flake8",
      "ms-python.black-formatter",
      "zxh404.vscode-proto3",
      "pkief.material-icon-theme",
      "ms-vscode.vscode-json",
      "redhat.vscode-yaml",
      "ms-kubernetes-tools.vscode-kubernetes-tools",
      "ms-vscode-remote.remote-containers"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "🌍 Install All Dependencies",
        "type": "shell",
        "command": "make",
        "args": ["install"],
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared"
        }
      },
      {
        "label": "🚀 Start All Services",
        "type": "shell",
        "command": "make",
        "args": ["start"],
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared"
        }
      },
      {
        "label": "🍚 Start ChainRice",
        "type": "shell",
        "command": "make",
        "args": ["chainrice"],
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared"
        }
      },
      {
        "label": "🐱 Start Meowtopia",
        "type": "shell",
        "command": "make",
        "args": ["meowtopia"],
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared"
        }
      },
      {
        "label": "🛑 Stop All Services",
        "type": "shell",
        "command": "make",
        "args": ["stop"],
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared"
        }
      },
      {
        "label": "📊 Check Status",
        "type": "shell",
        "command": "make",
        "args": ["status"],
        "group": "test",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared"
        }
      },
      {
        "label": "🌐 Open Interfaces",
        "type": "shell",
        "command": "make",
        "args": ["open"],
        "group": "test",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared"
        }
      },
      {
        "label": "🐳 Docker Start",
        "type": "shell",
        "command": "make",
        "args": ["docker"],
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared"
        }
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "🍚 ChainRice Go API",
        "type": "go",
        "request": "launch",
        "mode": "auto",
        "program": "${workspaceFolder}/apps/chain-rice/backend/go",
        "cwd": "${workspaceFolder}/apps/chain-rice/backend/go",
        "env": {
          "DATABASE_URL": "sqlite:///./accounting.db",
          "GRPC_PORT": "9090",
          "HTTP_PORT": "8004"
        }
      },
      {
        "name": "🤖 Python AI Service",
        "type": "python",
        "request": "launch",
        "program": "${workspaceFolder}/apps/chain-rice/backend/python/main.py",
        "cwd": "${workspaceFolder}/apps/chain-rice/backend/python",
        "env": {
          "API_PORT": "8005"
        }
      }
    ]
  }
}