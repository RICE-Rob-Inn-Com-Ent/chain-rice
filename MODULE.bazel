# ============================================================================
# Production Best Practices
# ============================================================================

# PERFORMANCE TUNING:
# 1. Enable remote caching: bazel build --remote_cache=grpc://cache.internal:9092
# 2. Use remote execution: bazel build --remote_executor=grpc://rbe.internal:8980
# 3. Enable build without bytes: --remote_download_minimal
# 4. Optimize workers: --jobs=auto --local_resources=cpu=HOST_CPUS*.9

# SECURITY:
# 1. Enable lockfile: bazel mod tidy --lockfile_mode=update
# 2. Verify integrity: All external deps use sha256 checksums
# 3. Network isolation: --sandbox_default_allow_network=false
# 4. Disable implicit deps: --incompatible_disable_starlark_host_transitions

# RELIABILITY:
# 1. Hermetic Python: Uses in-repo toolchains, no system deps
# 2. Reproducible builds: All versions pinned, no floating tags
# 3. Incremental correctness: Action caching with content-based keys
# 4. Cross-platform: Linux, macOS, Windows (WSL2) support

# OBSERVABILITY:
# 1. Build event protocol: --build_event_json_file=build_events.json
# 2. Profile builds: --profile=build_profile.gz
# 3. Memory tracking: --experimental_oom_more_eagerly
# 4. Execution log: --execution_log_json_file=exec.log

# CI/CD OPTIMIZATION:
# 1. Stamping for releases: --stamp (or --nostamp for cache hits)
# 2. Test sharding: bazel test --test_sharding_strategy=explicit
# 3. Flaky test retry: --flaky_test_attempts=3
# 4. Target pattern: Use '/...' with '--' exclusions for precision

# TEAM COLLABORATION:
# 1. Shared .bazelrc: Keep build configs in version control
# 2. User-specific .bazelrc.user: Personal settings (gitignored)
# 3. CI .bazelrc.ci: Optimized for automation
# 4. Remote caching: Critical for large teams (10x+ speedup)
