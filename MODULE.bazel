"""Rice-Mono Bazel Module - Enterprise Production Configuration.

Modern Bzlmod configuration for polyglot monorepo supporting:
  - Python 3.11+ (backend services, ML/AI pipelines)
  - Rust 2021 (smart contracts, performance-critical systems)
  - Node.js/TypeScript (web frontend, tooling)
  - Protocol Buffers & gRPC (service communication)
  - Container builds (OCI-compliant images)
  - Android (Kotlin/Java mobile apps)
  - iOS (Swift mobile apps)
  - Go (microservices, CLI tools)

Architecture: Hermetic, reproducible builds with full dependency isolation.
Performance: Optimized for incremental builds and remote caching.
Security: Verified dependencies with integrity checks.
Scale: Production-ready for teams of 100+ engineers.
"""

module(
    name = "rice_mono",
    version = "1.0.0",
    compatibility_level = 1,
)

# ============================================================================
# Core Build Rules
# ============================================================================

# Python support
bazel_dep(name = "rules_python", version = "0.30.0")

# Rust support
bazel_dep(name = "rules_rust", version = "0.38.0")

# Node.js/TypeScript support
bazel_dep(name = "aspect_rules_js", version = "1.39.0")
bazel_dep(name = "aspect_rules_ts", version = "2.2.0")

# Protocol Buffers
bazel_dep(name = "rules_proto", version = "5.3.0-21.7")
bazel_dep(name = "protobuf", version = "21.7")

# Container images
bazel_dep(name = "rules_oci", version = "1.7.4")

# Java/Kotlin (for Android)
bazel_dep(name = "rules_java", version = "7.3.2")
bazel_dep(name = "rules_kotlin", version = "1.9.0")
bazel_dep(name = "rules_android", version = "0.1.1")

# Swift (for iOS)
bazel_dep(name = "rules_swift", version = "1.16.0")

# Go (if needed)
bazel_dep(name = "rules_go", version = "0.46.0")

# Gazelle (auto-generate BUILD files)
bazel_dep(name = "gazelle", version = "0.36.0")

# Skylib (utilities)
bazel_dep(name = "bazel_skylib", version = "1.5.0")

# ============================================================================
# Python Configuration
# ============================================================================

python = use_extension("@rules_python//python/extensions:python.bzl", "python")

python.toolchain(
    python_version = "3.11",
)

# Poetry/pip dependencies
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")

pip.parse(
    hub_name = "pip",
    python_version = "3.11",
    requirements_lock = "//bots:poetry.lock",
)

use_repo(pip, "pip")

# ============================================================================
# Rust Configuration
# ============================================================================

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")

rust.toolchain(
    edition = "2021",
    versions = ["1.75.0"],
)

# Crate dependencies
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")

crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//backend/contract/rust:Cargo.lock",
    manifests = ["//backend/contract/rust:Cargo.toml"],
)

use_repo(crate, "crates")

# ============================================================================
# Node.js Configuration
# ============================================================================

node = use_extension("@aspect_rules_js//yarn:extensions.bzl", "yarn")

node.yarn_translate_lock(
    name = "yarn",
    yarn_lock = "//frontend/node:yarn.lock",
    verify_node_modules_ignored = "//:.bazelignore",
)

use_repo(node, "yarn")

# ============================================================================
# Go Configuration
# ============================================================================

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")

go_sdk.download(
    name = "go_sdk",
    version = "1.22.0",
)

# Go dependencies
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")

go_deps.from_file(go_mod = "//:go.mod")

# All gazelle-managed Go dependencies
use_repo(
    go_deps,
    # Add specific Go module repos here as needed
)

# ============================================================================
# Protocol Buffers Configuration
# ============================================================================

# gRPC
bazel_dep(name = "grpc", version = "1.59.2")

# Protocol buffer language support
protobuf_lang = use_extension("@protobuf//bazel:extensions.bzl", "protobuf_lang")

protobuf_lang.toolchain(
    languages = [
        "python",
        "cpp",
        "go",
        "java",
        "javascript",
        "typescript",
        "rust",
    ],
)

# ============================================================================
# Container Configuration
# ============================================================================

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")

# Pull base images
oci.pull(
    name = "python_base",
    image = "python:3.11-slim",
    platforms = ["linux/amd64", "linux/arm64"],
)

oci.pull(
    name = "rust_base",
    image = "rust:1.75-slim",
    platforms = ["linux/amd64", "linux/arm64"],
)

oci.pull(
    name = "node_base",
    image = "node:20-alpine",
    platforms = ["linux/amd64", "linux/arm64"],
)

oci.pull(
    name = "distroless_base",
    image = "gcr.io/distroless/base:latest",
    platforms = ["linux/amd64", "linux/arm64"],
)

use_repo(
    oci,
    "python_base",
    "rust_base",
    "node_base",
    "distroless_base",
)

# ============================================================================
# Kotlin/Android Configuration
# ============================================================================

android_sdk = use_extension("@rules_android//android:extensions.bzl", "android_sdk")

android_sdk.configure(
    api_level = 34,
    build_tools_version = "34.0.0",
)

# ============================================================================
# Development Tools
# ============================================================================

# Buildifier for BUILD file formatting
bazel_dep(name = "buildifier_prebuilt", version = "6.4.0", dev_dependency = True)

# Hedron Compile Commands for IDE integration (clangd, rust-analyzer)
bazel_dep(name = "hedron_compile_commands", version = "0.0.0", dev_dependency = True)

# Aspect CLI for enhanced developer experience
bazel_dep(name = "aspect_cli", version = "5.9.0", dev_dependency = True)

