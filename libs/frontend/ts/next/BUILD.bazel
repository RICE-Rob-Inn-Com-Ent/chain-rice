load("@build_bazel_rules_nodejs//:index.bzl", "npm_package")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")

# Next.js dependencies
npm_link_all_packages(name = "next_deps")

# Next.js TypeScript library
ts_project(
    name = "next_lib",
    srcs = glob(["**/*.ts", "**/*.tsx"]),
    deps = [
        ":next_deps",
        "@npm//next",
        "@npm//react",
        "@npm//react-dom",
        "@npm//react-router-dom",
    ],
    visibility = ["//visibility:public"],
)

# Next.js package
npm_package(
    name = "next_package",
    srcs = glob(["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.json"]),
    deps = [":next_lib"],
    visibility = ["//visibility:public"],
)
