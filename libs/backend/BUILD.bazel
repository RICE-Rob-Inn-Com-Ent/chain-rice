load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@rules_java//java:defs.bzl", "java_binary", "java_library")

# Go main - simplified without external deps
go_binary(
    name = "go_main",
    srcs = glob(["shared/**/*.go"]),
    importpath = "chainrice/shared",
    visibility = ["//visibility:public"],
)

# JVM bridge
java_binary(
    name = "jvm_bridge",
    srcs = glob(
        ["JVM/**/*.java"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

# CPython bridge
py_binary(
    name = "cpython_bridge",
    srcs = glob(
        ["CPython/**/*.py"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
