load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")

# Message protos
proto_library(
    name = "message_proto",
    srcs = ["message/god.proto"],
    visibility = ["//visibility:public"],
    deps = [
        "@com_google_protobuf//:timestamp_proto",
    ],
)

go_proto_library(
    name = "message_go_proto",
    importpath = "github.com/rice-mono/schema/bot/message",
    proto = ":message_proto",
    visibility = ["//visibility:public"],
)

# Enum protos
proto_library(
    name = "enum_proto",
    srcs = ["enum/god_enums.proto"],
    visibility = ["//visibility:public"],
)

go_proto_library(
    name = "enum_go_proto",
    importpath = "github.com/rice-mono/schema/bot/enum",
    proto = ":enum_proto",
    visibility = ["//visibility:public"],
)

# Service protos
proto_library(
    name = "service_proto",
    srcs = ["service/pantheon.proto"],
    visibility = ["//visibility:public"],
    deps = [
        ":enum_proto",
        ":message_proto",
        "@com_google_protobuf//:empty_proto",
    ],
)

go_proto_library(
    name = "service_go_proto",
    compilers = ["@io_bazel_rules_go//proto:go_grpc"],
    importpath = "github.com/rice-mono/schema/bot/service",
    proto = ":service_proto",
    visibility = ["//visibility:public"],
    deps = [
        ":enum_go_proto",
        ":message_go_proto",
    ],
)

# Aggregate library for bot schema
go_library(
    name = "bot",
    embed = [
        ":message_go_proto",
        ":enum_go_proto",
        ":service_go_proto",
    ],
    importpath = "github.com/rice-mono/schema/bot",
    visibility = ["//visibility:public"],
)
