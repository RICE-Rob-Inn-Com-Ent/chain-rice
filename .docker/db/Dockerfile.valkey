ARG VALKEY_VERSION=8.0
FROM valkey/valkey:${VALKEY_VERSION}-alpine
COPY .docker/db/valkey.conf /etc/valkey/valkey.conf
EXPOSE 6379
HEALTHCHECK --interval=5s --timeout=3s --retries=5 \
  CMD ["valkey-cli", "ping"]
CMD ["valkey-server", "/etc/valkey/valkey.conf"]