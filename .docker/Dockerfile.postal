# syntax=docker/dockerfile:1
# Postal — full Ruby stack; no upstream distroless. Dev uses mailpit profile; this stub keeps compose graph valid.
ARG EXPOSE_PORT=5000
ARG GO_VERSION=1.23.4
FROM golang:${GO_VERSION}-bookworm AS build
WORKDIR /src
COPY .docker/rice-healthd/go.mod .docker/rice-healthd/main.go ./
RUN --mount=type=cache,target=/go/pkg/mod \
	CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /rice-healthd .

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /rice-healthd /rice-healthd
ARG EXPOSE_PORT
ENV PORT=${EXPOSE_PORT}
EXPOSE ${EXPOSE_PORT}
USER nonroot:nonroot
ENTRYPOINT ["/rice-healthd"]
