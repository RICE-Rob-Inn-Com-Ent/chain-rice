# syntax=docker/dockerfile:1
# YugabyteDB — JVM stack; distroless not applicable. Pin version via Renovate / CUE.
ARG YUGABYTE_VERSION=latest
FROM yugabytedb/yugabyte:${YUGABYTE_VERSION}
USER root
RUN mkdir -p /opt/rice
COPY .docker/etc/init.sql /opt/rice/init.sql
USER yugabyte
EXPOSE 5433 9042 7000 9000
CMD ["bin/yugabyted", "start", "--background=false", "--ui", "true"]
