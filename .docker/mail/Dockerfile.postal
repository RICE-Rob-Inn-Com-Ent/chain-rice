# Generated — cue cmd gen ./infra
# Params: infra/proto/cue/infra.cue + infra/gen/chief/ (Mint from custom/*/infra/docker.rice)
# syntax=docker/dockerfile:1
ARG EXPOSE_PORT=5000
FROM alpine:3.20
RUN apk add --no-cache ca-certificates wget
EXPOSE ${EXPOSE_PORT}
HEALTHCHECK --interval=10s --timeout=5s --retries=5 CMD wget -q -O- http://127.0.0.1:5000/ >/dev/null 2>&1 || exit 0
CMD ["sleep", "infinity"]