# syntax=docker/dockerfile:1
# Valkey — minimal vendor image (Alpine). True distroless is not published upstream; this is the smallest supported runtime.
ARG VALKEY_VERSION=8.0
FROM valkey/valkey:${VALKEY_VERSION}-alpine
COPY .docker/conf/valkey.conf /etc/valkey/valkey.conf
EXPOSE 6379
CMD ["valkey-server", "/etc/valkey/valkey.conf"]
