{
  "name": "rice-mono",
  "version": "1.0.0",
  "private": true,
  "description": "Rice Monorepo - UI Kit & Next.js Web Application",
  "workspaces": [".frontend/web", ".frontend/web-marketing", ".project/web"],
  "scripts": {
    "dev": "concurrently -n \"admin,marketing\" -c \"cyan,magenta\" \"yarn workspace @rice-mono/ui-kit dev\" \"yarn workspace @rice-mono/marketing dev\"",
    "dev:admin": "yarn workspace @rice-mono/ui-kit dev",
    "dev:marketing": "yarn workspace @rice-mono/marketing dev",
    "dev:all": "concurrently -n \"admin,marketing,next\" -c \"cyan,magenta,green\" \"yarn workspace @rice-mono/ui-kit dev\" \"yarn workspace @rice-mono/marketing dev\" \"yarn workspace rice-web dev\"",
    "build": "yarn workspaces run build",
    "clean": "yarn workspaces run clean",
    "lint": "yarn workspaces run lint",
    "typecheck": "yarn workspaces run typecheck"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
