load("@gazelle//:def.bzl", "gazelle")
load("//rules:nix.bzl", "nix_shell", "nix_build", "nix_test")
load("//rules:go_toolchain.bzl", "nix_go_toolchain")
load("//rules:python_toolchain.bzl", "nix_python_toolchain")
load("//rules:rust_toolchain.bzl", "nix_rust_toolchain")
load("//rules:proto_toolchain.bzl", "nix_proto_toolchain")

# This is the root BUILD file for the rice-dev Bazel module
package(default_visibility = ["//visibility:public"])

# Gazelle rule to automatically generate BUILD files
gazelle(
    name = "gazelle",
    gazelle = "@gazelle//cmd/gazelle",
)

# Proto filegroup for all protobuf definitions
filegroup(
    name = "proto_files",
    srcs = glob([
        "libs/proto/**/*.proto",
    ], allow_empty = True),
    visibility = ["//visibility:public"],
)

# Go modules filegroup
filegroup(
    name = "go_mod_files", 
    srcs = glob([
        "libs/backend/**/go.mod",
        "libs/backend/**/go.sum",
    ], allow_empty = True),
    visibility = ["//visibility:public"],
)

# Nix development shells for different environments
nix_shell(
    name = "nix_default",
    flake_path = ".",
    shell_name = "default",
    visibility = ["//visibility:public"],
)

nix_shell(
    name = "nix_go",
    flake_path = ".",
    shell_name = "go-backend",
    visibility = ["//visibility:public"],
)

nix_shell(
    name = "nix_python",
    flake_path = ".",
    shell_name = "python-fastapi-bridge",
    visibility = ["//visibility:public"],
)

nix_shell(
    name = "nix_rust",
    flake_path = ".",
    shell_name = "rust-cosmos",
    visibility = ["//visibility:public"],
)

nix_shell(
    name = "nix_proto",
    flake_path = ".",
    shell_name = "proto-tools",
    visibility = ["//visibility:public"],
)

nix_shell(
    name = "nix_devops",
    flake_path = ".",
    shell_name = "terraform",
    visibility = ["//visibility:public"],
)

nix_shell(
    name = "nix_monorepo",
    flake_path = ".",
    shell_name = "monorepo",
    visibility = ["//visibility:public"],
)

# Nix-based build targets
nix_build(
    name = "nix_build_all",
    flake_path = ".",
    shell_name = "default",
    targets = ["//..."],
    visibility = ["//visibility:public"],
)

nix_build(
    name = "nix_build_go",
    flake_path = ".",
    shell_name = "go-backend",
    targets = ["//libs/backend/..."],
    visibility = ["//visibility:public"],
)

nix_build(
    name = "nix_build_python",
    flake_path = ".",
    shell_name = "python-fastapi-bridge",
    targets = ["//bots/core/...", "//bots/integration/...", "//libs/connection/FastAPI/..."],
    visibility = ["//visibility:public"],
)

nix_build(
    name = "nix_build_rust",
    flake_path = ".",
    shell_name = "rust-cosmos",
    targets = ["//libs/contract/rust/..."],
    visibility = ["//visibility:public"],
)

nix_build(
    name = "nix_build_proto",
    flake_path = ".",
    shell_name = "proto-tools",
    targets = ["//libs/proto/..."],
    visibility = ["//visibility:public"],
)

nix_build(
    name = "nix_build_frontend",
    flake_path = ".",
    shell_name = "ts-shared",
    targets = ["//libs/frontend/ts/...", "//projects/chain-rice/...", "//projects/meowtopia/frontend/..."],
    visibility = ["//visibility:public"],
)

# Nix-based test targets
nix_test(
    name = "nix_test_all",
    flake_path = ".",
    shell_name = "default",
    targets = ["//..."],
    visibility = ["//visibility:public"],
)

nix_test(
    name = "nix_test_python",
    flake_path = ".",
    shell_name = "python-fastapi-bridge",
    targets = ["//bots/core/...", "//bots/integration/..."],
    visibility = ["//visibility:public"],
)

nix_test(
    name = "nix_test_frontend",
    flake_path = ".",
    shell_name = "ts-shared",
    targets = ["//libs/frontend/ts/...", "//projects/chain-rice/...", "//projects/meowtopia/frontend/..."],
    visibility = ["//visibility:public"],
)

# Nix toolchain targets
nix_go_toolchain(
    name = "nix_go_toolchain",
    flake_path = ".",
    shell_name = "go-backend",
    visibility = ["//visibility:public"],
)

nix_python_toolchain(
    name = "nix_python_toolchain",
    flake_path = ".",
    shell_name = "python-fastapi-bridge",
    visibility = ["//visibility:public"],
)

nix_rust_toolchain(
    name = "nix_rust_toolchain",
    flake_path = ".",
    shell_name = "rust-cosmos",
    visibility = ["//visibility:public"],
)

nix_proto_toolchain(
    name = "nix_proto_toolchain",
    flake_path = ".",
    shell_name = "proto-tools",
    visibility = ["//visibility:public"],
)

# Convenience aliases for common operations
alias(
    name = "dev",
    actual = ":nix_monorepo",
    visibility = ["//visibility:public"],
)

alias(
    name = "monorepo",
    actual = ":nix_monorepo",
    visibility = ["//visibility:public"],
)

alias(
    name = "build",
    actual = ":nix_build_all",
    visibility = ["//visibility:public"],
)

alias(
    name = "test",
    actual = ":nix_test_all",
    visibility = ["//visibility:public"],
)

# Toolchain aliases
alias(
    name = "go_toolchain",
    actual = ":nix_go_toolchain",
    visibility = ["//visibility:public"],
)

alias(
    name = "python_toolchain",
    actual = ":nix_python_toolchain",
    visibility = ["//visibility:public"],
)

alias(
    name = "rust_toolchain",
    actual = ":nix_rust_toolchain",
    visibility = ["//visibility:public"],
)

alias(
    name = "proto_toolchain",
    actual = ":nix_proto_toolchain",
    visibility = ["//visibility:public"],
)
