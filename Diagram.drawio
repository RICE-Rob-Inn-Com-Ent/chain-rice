        <mxCell id="PHxiAXBZ9Zwz3M3vVkmd-27" parent="NetWeRefARGaiRHp-jNh-302" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;align=right;strokeColor=#39FF14;" value="&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Finance.hs&lt;/b&gt;&lt;/span&gt;" vertex="1">
