        <mxCell id="PHxiAXBZ9Zwz3M3vVkmd-42" parent="NetWeRefARGaiRHp-jNh-304" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;align=right;strokeColor=#39FF14;" value="&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;AuditSpec.hs&lt;/b&gt;&lt;/span&gt;" vertex="1">
