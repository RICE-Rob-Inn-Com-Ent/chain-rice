        <mxCell id="buZBv7jyl6kujNXGrouv-947" parent="buZBv7jyl6kujNXGrouv-944" style="rounded=0;whiteSpace=wrap;html=1;align=center;strokeWidth=2;strokeColor=#39FF14;dashed=1;dashPattern=12 12;" value="&lt;div style=&quot;line-height: 180%; color: rgb(123, 136, 161);&quot;&gt;&lt;div style=&quot;color: rgb(123, 136, 161); white-space: pre;&quot;&gt;&lt;h3 data-path-to-node=&quot;6&quot; style=&quot;color: rgb(255, 255, 255); white-space: normal; line-height: 180%;&quot;&gt;&lt;b data-path-to-node=&quot;6&quot; data-index-in-node=&quot;0&quot;&gt;&lt;font style=&quot;font-size: 12px; line-height: 180%;&quot; face=&quot;Helvetica&quot;&gt;The Atomic Hardware Bridge&lt;/font&gt;&lt;/b&gt;&lt;/h3&gt;&lt;p data-path-to-node=&quot;7&quot; style=&quot;font-size: 12px; color: rgb(255, 255, 255); white-space: normal;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;b data-path-to-node=&quot;7&quot; data-index-in-node=&quot;0&quot;&gt;Purpose:&lt;/b&gt;&amp;nbsp;Minimalist, near-metal glue for FFI and primitive byte operations.&lt;/font&gt;&lt;/p&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;b data-path-to-node=&quot;8,0,0&quot; data-index-in-node=&quot;0&quot; style=&quot;font-size: 12px; color: rgb(255, 255, 255); white-space: normal; background-color: transparent;&quot;&gt;FFI Glue:&lt;/b&gt;&lt;span style=&quot;font-size: 12px; color: rgb(255, 255, 255); white-space: normal; background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;code data-path-to-node=&quot;8,0,0&quot; data-index-in-node=&quot;10&quot; style=&quot;font-size: 12px; color: rgb(255, 255, 255); white-space: normal; background-color: transparent;&quot;&gt;libloading&lt;/code&gt;&lt;span style=&quot;font-size: 12px; color: rgb(255, 255, 255); white-space: normal; background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 12px; color: rgb(255, 255, 255); white-space: normal; background-color: transparent;&quot;&gt;and&lt;/span&gt;&lt;span style=&quot;font-size: 12px; color: rgb(255, 255, 255); white-space: normal; background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;code data-path-to-node=&quot;8,0,0&quot; data-index-in-node=&quot;25&quot; style=&quot;font-size: 12px; color: rgb(255, 255, 255); white-space: normal; background-color: transparent;&quot;&gt;libc&lt;/code&gt;&lt;span style=&quot;font-size: 12px; color: rgb(255, 255, 255); white-space: normal; background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 12px; color: rgb(255, 255, 255); white-space: normal; background-color: transparent;&quot;&gt;live here so you can dynamically load the&lt;/span&gt;&lt;span style=&quot;font-size: 12px; color: rgb(255, 255, 255); white-space: normal; background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;b data-path-to-node=&quot;8,0,0&quot; data-index-in-node=&quot;72&quot; style=&quot;font-size: 12px; color: rgb(255, 255, 255); white-space: normal; background-color: transparent;&quot;&gt;Haskell CALC&lt;/b&gt;&lt;span style=&quot;font-size: 12px; color: rgb(255, 255, 255); white-space: normal; background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 12px; color: rgb(255, 255, 255); white-space: normal; background-color: transparent;&quot;&gt;and&lt;/span&gt;&lt;span style=&quot;font-size: 12px; color: rgb(255, 255, 255); white-space: normal; background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;b data-path-to-node=&quot;8,0,0&quot; data-index-in-node=&quot;89&quot; style=&quot;font-size: 12px; color: rgb(255, 255, 255); white-space: normal; background-color: transparent;&quot;&gt;Zig Security&lt;/b&gt;&lt;span style=&quot;font-size: 12px; color: rgb(255, 255, 255); white-space: normal; background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 12px; color: rgb(255, 255, 255); white-space: normal; background-color: transparent;&quot;&gt;libraries without polluting higher-level logic with unsafe pointers.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(123, 136, 161);&quot;&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;&quot;&gt;&lt;br&gt;&lt;b data-path-to-node=&quot;8,1,0&quot; data-index-in-node=&quot;0&quot; style=&quot;color: rgb(255, 255, 255); white-space: normal; font-size: 12px; background-color: transparent;&quot;&gt;No-Inference Foundation:&lt;/b&gt;&lt;span style=&quot;color: rgb(255, 255, 255); white-space: normal; font-size: 12px; background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;code data-path-to-node=&quot;8,1,0&quot; data-index-in-node=&quot;25&quot; style=&quot;color: rgb(255, 255, 255); white-space: normal; font-size: 12px; background-color: transparent;&quot;&gt;bytes&lt;/code&gt;&lt;span style=&quot;color: rgb(255, 255, 255); white-space: normal; font-size: 12px; background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(255, 255, 255); white-space: normal; font-size: 12px; background-color: transparent;&quot;&gt;and&lt;/span&gt;&lt;span style=&quot;color: rgb(255, 255, 255); white-space: normal; font-size: 12px; background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;code data-path-to-node=&quot;8,1,0&quot; data-index-in-node=&quot;35&quot; style=&quot;color: rgb(255, 255, 255); white-space: normal; font-size: 12px; background-color: transparent;&quot;&gt;hex&lt;/code&gt;&lt;span style=&quot;color: rgb(255, 255, 255); white-space: normal; font-size: 12px; background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(255, 255, 255); white-space: normal; font-size: 12px; background-color: transparent;&quot;&gt;are the only allowed data carriers between kernels. Keeping&lt;/span&gt;&lt;span style=&quot;color: rgb(255, 255, 255); white-space: normal; font-size: 12px; background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;b data-path-to-node=&quot;8,1,0&quot; data-index-in-node=&quot;99&quot; style=&quot;color: rgb(255, 255, 255); white-space: normal; font-size: 12px; background-color: transparent;&quot;&gt;UTIL&lt;/b&gt;&lt;span style=&quot;color: rgb(255, 255, 255); white-space: normal; font-size: 12px; background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(255, 255, 255); white-space: normal; font-size: 12px; background-color: transparent;&quot;&gt;lean ensures the system boots in microseconds without a heavy dependency tree.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(123, 136, 161);&quot;&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;&quot;&gt;&lt;br&gt;&lt;b data-path-to-node=&quot;8,2,0&quot; data-index-in-node=&quot;0&quot; style=&quot;color: rgb(255, 255, 255); white-space: normal; font-size: 12px; background-color: transparent;&quot;&gt;Tracing:&lt;/b&gt;&lt;span style=&quot;color: rgb(255, 255, 255); white-space: normal; font-size: 12px; background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(255, 255, 255); white-space: normal; font-size: 12px; background-color: transparent;&quot;&gt;Basic logging starts at this level to monitor FFI boundary errors at an &quot;atomic&quot; level before they propagate.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
