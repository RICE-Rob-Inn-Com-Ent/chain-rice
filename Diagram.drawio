        <mxCell id="PHxiAXBZ9Zwz3M3vVkmd-122" parent="1" style="whiteSpace=wrap;html=1;shape=mxgraph.basic.document;strokeWidth=2;strokeColor=#39FF14;fillColor=none;" value="" vertex="1">
