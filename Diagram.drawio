        <mxCell id="NetWeRefARGaiRHp-jNh-1078" parent="buZBv7jyl6kujNXGrouv-966" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;align=right;strokeColor=#39FF14;" value="&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;lexer.rs&lt;/b&gt;&lt;/span&gt;" vertex="1">
