        <mxCell id="NetWeRefARGaiRHp-jNh-1177" parent="buZBv7jyl6kujNXGrouv-978" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;align=right;strokeColor=#39FF14;" value="&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;setup.rs&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="40" width="680" x="80" y="3880" as="geometry" />
        </mxCell>
        <mxCell id="NetWeRefARGaiRHp-jNh-1178" parent="buZBv7jyl6kujNXGrouv-978" style="verticalLabelPosition=bottom;html=1;verticalAlign=top;align=center;strokeColor=none;fillColor=#39FF14;shape=mxgraph.azure.script_file;pointerEvents=1;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=default;fontStyle=1;" value="" vertex="1">
