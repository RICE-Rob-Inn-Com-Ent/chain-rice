        <mxCell id="buZBv7jyl6kujNXGrouv-983" parent="buZBv7jyl6kujNXGrouv-980" style="rounded=0;whiteSpace=wrap;html=1;align=center;strokeWidth=2;strokeColor=#39FF14;dashed=1;dashPattern=12 12;" value="&lt;div style=&quot;line-height: 180%;&quot;&gt;&lt;b data-path-to-node=&quot;18&quot; data-index-in-node=&quot;0&quot; style=&quot;background-color: transparent; white-space: pre;&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot; face=&quot;Helvetica&quot;&gt;The Financial Judiciary&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 180%;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;b data-path-to-node=&quot;19&quot; data-index-in-node=&quot;0&quot; style=&quot;background-color: transparent; white-space: pre;&quot;&gt;Purpose:&lt;/b&gt;&lt;span style=&quot;background-color: transparent; white-space: pre;&quot;&gt; Evaluating business and&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 180%;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;background-color: transparent; white-space: pre;&quot;&gt;security logic against global standards.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b data-path-to-node=&quot;20,0,0&quot; data-index-in-node=&quot;0&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;CEL Integration:&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; &lt;/span&gt;&lt;code data-path-to-node=&quot;20,0,0&quot; data-index-in-node=&quot;17&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;cel-interpreter&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; allows for the safe execution of rules (e.g., &quot;Is the user over their leverage limit?&quot;) without the risk of infinite loops or system crashes (Non-Turing-complete).&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 180%;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span data-path-to-node=&quot;20,1,0&quot; data-index-in-node=&quot;0&quot; style=&quot;background-color: transparent;&quot;&gt;&lt;br&gt;&lt;b&gt;Financial Protocols:&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; &lt;/span&gt;&lt;code data-path-to-node=&quot;20,1,0&quot; data-index-in-node=&quot;21&quot; style=&quot;background-color: transparent;&quot;&gt;fefix&lt;/code&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; (FIX) and &lt;/span&gt;&lt;code data-path-to-node=&quot;20,1,0&quot; data-index-in-node=&quot;37&quot; style=&quot;background-color: transparent;&quot;&gt;iso_currency&lt;/code&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; provide native understanding of market standards, making the system &quot;financially aware&quot; out of the box.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b data-path-to-node=&quot;20,2,0&quot; data-index-in-node=&quot;0&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Messaging:&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; &lt;/span&gt;&lt;code data-path-to-node=&quot;20,2,0&quot; data-index-in-node=&quot;11&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;nats&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; is an optional bridge, allowing the &lt;/span&gt;&lt;b data-path-to-node=&quot;20,2,0&quot; data-index-in-node=&quot;52&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Judiciary&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; to broadcast policy verdicts to other nodes in your sovereign network.&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;blockquote style=&quot;margin: 0px; border: none; padding: 0px;&quot;&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;/blockquote&gt;&lt;/blockquote&gt;&lt;/div&gt;" vertex="1">
