        <mxCell id="NetWeRefARGaiRHp-jNh-299" parent="NetWeRefARGaiRHp-jNh-292" style="rounded=0;whiteSpace=wrap;html=1;align=left;strokeWidth=2;strokeColor=#39FF14;dashed=1;dashPattern=12 12;" value="&lt;div style=&quot;font-family: &amp;quot;Fira Code&amp;quot;, &amp;quot;JetBrains Mono&amp;quot;, monospace, &amp;quot;Droid Sans Mono&amp;quot;, &amp;quot;monospace&amp;quot;, monospace; font-size: 14px; white-space: pre; line-height: 180%; color: rgb(123, 136, 161);&quot;&gt;&lt;div style=&quot;color: rgb(123, 136, 161);&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
