        <mxCell id="buZBv7jyl6kujNXGrouv-971" parent="buZBv7jyl6kujNXGrouv-968" style="rounded=0;whiteSpace=wrap;html=1;align=center;strokeWidth=2;strokeColor=#39FF14;dashed=1;dashPattern=12 12;" value="&lt;div style=&quot;font-size: 14px; white-space: pre; line-height: 180%;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot; face=&quot;Helvetica&quot;&gt;&lt;b data-path-to-node=&quot;14&quot; data-index-in-node=&quot;0&quot; style=&quot;font-size: 12px; white-space: normal; background-color: transparent;&quot;&gt;The Zero-Knowledge Vault&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot; face=&quot;Helvetica&quot;&gt;&lt;b&gt;&lt;br style=&quot;font-size: 12px; white-space: normal;&quot;&gt;&lt;/b&gt;&lt;b data-path-to-node=&quot;15&quot; data-index-in-node=&quot;0&quot; style=&quot;font-size: 12px; white-space: normal; background-color: transparent;&quot;&gt;Purpose:&lt;/b&gt;&lt;span style=&quot;font-size: 12px; white-space: normal; background-color: transparent;&quot;&gt;&amp;nbsp;Heavy-duty cryptography and memory-mapped proof handling.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;&lt;br style=&quot;font-size: 12px; white-space: normal;&quot;&gt;&lt;b data-path-to-node=&quot;16,0,0&quot; data-index-in-node=&quot;0&quot; style=&quot;font-size: 12px; white-space: normal; background-color: transparent;&quot;&gt;Mathematical Muscle:&lt;/b&gt;&lt;span style=&quot;font-size: 12px; white-space: normal; background-color: transparent;&quot;&gt;&amp;nbsp;The entire&amp;nbsp;&lt;/span&gt;&lt;code data-path-to-node=&quot;16,0,0&quot; data-index-in-node=&quot;32&quot; style=&quot;font-size: 12px; white-space: normal; background-color: transparent;&quot;&gt;arkworks&lt;/code&gt;&lt;span style=&quot;font-size: 12px; white-space: normal; background-color: transparent;&quot;&gt;&amp;nbsp;ecosystem (BN254) is isolated here. Because it’s the &quot;heaviest&quot; part of the system, we keep it far away from the lightweight contracts.&lt;/span&gt;&lt;br style=&quot;font-size: 12px; white-space: normal;&quot;&gt;&lt;b data-path-to-node=&quot;16,1,0&quot; data-index-in-node=&quot;0&quot; style=&quot;font-size: 12px; white-space: normal; background-color: transparent;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;&lt;b data-path-to-node=&quot;16,1,0&quot; data-index-in-node=&quot;0&quot; style=&quot;font-size: 12px; white-space: normal; background-color: transparent;&quot;&gt;Zero-Copy Performance:&lt;/b&gt;&lt;span style=&quot;font-size: 12px; white-space: normal; background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;code data-path-to-node=&quot;16,1,0&quot; data-index-in-node=&quot;23&quot; style=&quot;font-size: 12px; white-space: normal; background-color: transparent;&quot;&gt;memmap2&lt;/code&gt;&lt;span style=&quot;font-size: 12px; white-space: normal; background-color: transparent;&quot;&gt;&amp;nbsp;is critical. It allows the system to load massive Proving Keys directly into RAM without copying them, which is a requirement for viable ZK performance.&lt;/span&gt;&lt;br style=&quot;font-size: 12px; white-space: normal;&quot;&gt;&lt;font style=&quot;font-size: 12px; white-space: normal;&quot;&gt;&lt;b data-path-to-node=&quot;16,2,0&quot; data-index-in-node=&quot;0&quot; style=&quot;background-color: transparent;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;&lt;font style=&quot;font-size: 12px; white-space: normal;&quot;&gt;&lt;b data-path-to-node=&quot;16,2,0&quot; data-index-in-node=&quot;0&quot; style=&quot;background-color: transparent;&quot;&gt;Parallelism:&lt;/b&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;code data-path-to-node=&quot;16,2,0&quot; data-index-in-node=&quot;13&quot; style=&quot;background-color: transparent;&quot;&gt;rayon&lt;/code&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&amp;nbsp;forces the CPU to calculate complex polynomials across all available cores simultaneously.&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="600" width="280" x="100" y="159.47000000000003" as="geometry" />
        </mxCell>
