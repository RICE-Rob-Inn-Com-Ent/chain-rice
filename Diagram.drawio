        </mxCell>
        <mxCell id="PHxiAXBZ9Zwz3M3vVkmd-22" parent="NetWeRefARGaiRHp-jNh-302" style="verticalLabelPosition=bottom;html=1;verticalAlign=top;align=center;strokeColor=none;fillColor=#39FF14;shape=mxgraph.azure.script_file;pointerEvents=1;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=default;fontStyle=1;" value="" vertex="1">
