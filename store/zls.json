{
  "$schema": "https://raw.githubusercontent.com/zigtools/zls/master/config_schema.json",
  "zig_lib_path": null,
  "zig_exe_path": null,
  "wasi_sdk_path": null,
  "enable_semantic_tokens": true,
  "enable_inlay_hints": true,
  "inlay_hints_show_parameter_names": true,
  "inlay_hints_show_builtin": true,
  "inlay_hints_show_else_brance": true,
  "inlay_hints_single_line": false,
  "warn_style": true,
  "enable_snippets": true,
  "operator_completions": true,
  "include_at_in_builtins": false,
  "max_detail_length": 1048576,
  "build_runner_path": null,
  "global_cache_path": null,
  "enable_autofix": true,
  "enable_import_embedfile_argument_completions": true,
  "enable_import_embedfile_warn_embedded": true,
  "skip_std_references": false,
  "highlight_global_var_declarations": false,
  "record_session": false,
  "reload_on_save": true,
  "enable_incremental_semantic_tokens": true,
  "enable_reference_tracing": false,
  "reference_tracing_include_builtin": false,
  "reference_tracing_include_system_libs": false
}
