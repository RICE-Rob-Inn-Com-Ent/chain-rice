# shellcheck shell=bash
# cSpell:ignore DIRENV direnv dotenv
# ==============================================================================
# DIRENV CONFIGURATION - Rice Monorepo
# ==============================================================================
# This file configures direnv (https://direnv.net/) to automatically load
# development environment variables when entering this directory.
#
# direnv is a shell extension that loads and unloads environment variables
# depending on the current directory. This ensures consistent development
# environments across team members and CI/CD pipelines.
#
# Usage:
#   1. Install direnv: https://direnv.net/docs/installation.html
#   2. Allow this file: `direnv allow` (first time only)
#   3. Environment variables are automatically loaded when entering this directory
# ==============================================================================

# Enable strict mode:
# - Only variables explicitly set/exported in this file (or loaded via dotenv_if_exists) are allowed into the project environment.
# - Any variables from the parent shell that are not declared here are removed, which makes the environment deterministic and avoids leaking accidental settings.
strict_env

# Log direnv activity to provide user feedback during environment loading
log_status "⏳ Loading development environment..."

# ============================================================================
# ENVIRONMENT VALIDATION
# ============================================================================
# Validate critical environment variables and tools on load
if ! command -v direnv &> /dev/null; then
  echo "⚠️  Warning: direnv not found. Install from https://direnv.net/"
fi

# Validate required tools (Bun for JS/TS; no npm/pnpm/node)
REQUIRED_TOOLS=("bun" "go" "rustc")
for tool in "${REQUIRED_TOOLS[@]}"; do
  if ! command -v "$tool" &> /dev/null; then
    log_status "⚠️  Warning: $tool not found in PATH"
  fi
done

# Add system bin directories first
PATH_add "/usr/bin"
PATH_add "/usr/local/bin"
PATH_add "${HOME}/.local/bin"

# Add local bin directories (Bun uses node_modules/.bin)
PATH_add "./node_modules/.bin"
PATH_add "./.venv/bin"
PATH_add "./vendor/bin"

# Add mise (replacement for asdf) to PATH
if command -v mise &> /dev/null; then
  eval "$(mise activate bash)"
fi

# ============================================================================
# LANGUAGE RUNTIME SETTINGS
# ============================================================================
# These environment variables configure language-specific tooling and runtime
# behavior for consistent development across the monorepo.

# Python settings
# cSpell:ignore PYTHONUNBUFFERED PYTHONDONTWRITEBYTECODE VIRTUALENV virtualenv
export PYTHON_ENV=development              # Development mode flag for Python tooling and applications
export PYTHONUNBUFFERED=1                  # Unbuffered output for immediate log visibility (useful in containers/CI)
export PYTHONDONTWRITEBYTECODE=1           # Disable bytecode cache files (.pyc) to keep repo clean
export PIP_REQUIRE_VIRTUALENV=true         # Require virtualenv for pip installs to prevent global Python pollution

# Go settings
# cSpell:ignore GOPRIVATE
export GO_ENV=development                  # Development mode flag for Go tooling and applications
export GOPRIVATE="github.com/RICE-Rob-Inn-Com-Ent"  # Mark private modules to prevent metadata leaks to public Go proxy

# Rust settings
export RUST_ENV=development                # Development mode flag for Rust tooling and applications
export RUST_BACKTRACE=1                    # Enable full stack traces on panic for easier debugging

# Bun / JS/TS (Bun respects NODE_ENV for compatibility)
export NODE_ENV=development
export BUN_INSTALL_NO_SAVE_SCRIPTS=0
export NEXT_TELEMETRY_DISABLED=1

# Java settings
export JAVA_ENV=development                # Development mode flag for Java tooling and applications
export JAVA_OPTS="-Xmx4g -XX:+UseG1GC"     # Set JVM heap limit to 4GB and use G1GC for better performance

# Kotlin settings
export KOTLIN_ENV=development              # Development mode flag for Kotlin tooling (uses JAVA_OPTS / GRADLE_OPTS / MAVEN_OPTS from Java section)

# Swift settings
export SWIFT_ENV=development               # Development mode flag for Swift tooling and applications

# Flutter settings
export FLUTTER_ENV=development             # Development mode flag for Flutter tooling and applications
export FLUTTER_CLI_TELEMETRY_DISABLED=1    # Disable Flutter CLI telemetry

# ============================================================================
# INFRASTRUCTURE SERVICES (DevContainer defaults)
# ============================================================================
# Database services
export DATABASE_URL="postgresql://devcontainer-postgres:5432"  # PostgreSQL connection URL (priority)
export POSTGRES_HOST="devcontainer-postgres"                      # PostgreSQL hostname (fallback)
export POSTGRES_PORT=5432                                      # PostgreSQL port (fallback)
export MONGODB_URL="mongodb://devcontainer-mongodb:27017"       # MongoDB connection URL (priority)
export MONGODB_HOST="devcontainer-mongodb"                       # MongoDB hostname (fallback)
export MONGODB_PORT=27017                                      # MongoDB port (fallback)
export REDIS_URL="redis://devcontainer-redis:6379"             # Redis connection URL (priority)
export REDIS_HOST="devcontainer-redis"                           # Redis hostname (fallback)
export REDIS_PORT=6379                                         # Redis port (fallback)

# Messaging services
export KAFKA_BROKER="devcontainer-kafka:29092"           # Kafka broker address
export KAFKA_ZOOKEEPER="devcontainer-zookeeper:2181"     # Zookeeper address for Kafka
export RABBITMQ_URL="amqp://admin:admin@devcontainer-rabbitmq:5672"  # RabbitMQ connection URL

# Storage services
export MINIO_ENDPOINT="devcontainer-minio:9000"          # MinIO S3-compatible storage endpoint
export MINIO_USE_SSL=false                             # Disable SSL for local MinIO
# cSpell:ignore MLFLOW mlflow
export MLFLOW_S3_ENDPOINT_URL="http://minio:9000"        # MLflow S3 endpoint (MinIO)
export MLFLOW_DEFAULT_ARTIFACT_ROOT="s3://mlflow-artifacts"  # MLflow default artifact storage

# AI/ML services
# MLflow: Open-source platform for managing the ML lifecycle (experiments, models, deployments)
export MLFLOW_TRACKING_URI="http://devcontainer-mlflow:5000"  # MLflow tracking server URL
# cSpell:ignore OLLAMA Ollama
# Ollama: Local LLM runtime for running large language models
export OLLAMA_URL="http://devcontainer-ollama:11434"           # Ollama LLM service URL
export OLLAMA_HOST="0.0.0.0:11434"                             # Ollama host binding
# cSpell:ignore LANGGRAPH
# LangGraph: Framework for building stateful, multi-actor applications with LLMs
export LANGGRAPH_STUDIO_URL="http://devcontainer-langgraph-studio:8123"  # LangGraph Studio URL
export WEAVIATE_URL="http://devcontainer-weaviate:8080"         # Weaviate vector database URL (priority)                                     # Weaviate port (fallback)

# IPFS services
# cSpell:ignore IPFS
# IPFS: InterPlanetary File System - distributed file storage protocol
export IPFS_API_URL="http://devcontainer-ipfs:5001"      # IPFS API endpoint
export IPFS_GATEWAY_URL="http://devcontainer-ipfs:8080"  # IPFS gateway URL

# Monitoring & Observability
export PROMETHEUS_URL="http://devcontainer-prometheus:9090"                    # Prometheus metrics server
export GRAFANA_URL="http://devcontainer-grafana:3000"                          # Grafana dashboard
export JAEGER_QUERY_URL="http://devcontainer-jaeger:16686"                     # Jaeger trace query UI
export JAEGER_COLLECTOR_URL="http://devcontainer-jaeger:4318/v1/traces"        # Jaeger trace collector
export OTEL_EXPORTER_OTLP_ENDPOINT="http://devcontainer-jaeger:4318/v1/traces"  # OpenTelemetry OTLP endpoint
export OTEL_EXPORTER_OTLP_METRICS_ENDPOINT="http://devcontainer-prometheus:4318/v1/metrics"  # OpenTelemetry metrics endpoint
export OTEL_METRIC_EXPORT_INTERVAL=15000                                      # OpenTelemetry metric export interval (ms)
export LOKI_URL="http://devcontainer-loki:3100"                                 # Loki log aggregation service
export ELASTICSEARCH_URL="http://devcontainer-elasticsearch:9200"               # Elasticsearch connection URL (priority)
export ELASTICSEARCH_HOST="devcontainer-elasticsearch"                          # Elasticsearch hostname (fallback)
export ELASTICSEARCH_PORT=9200                                                 # Elasticsearch port (fallback)

# Infrastructure as Code
export VAULT_ADDR="http://devcontainer-vault:8200"      # HashiCorp Vault address
export VAULT_TOKEN="root-token-dev"                     # Vault dev token (non-secret for local dev)
export VAULT_NAMESPACE=""                               # Vault namespace (enterprise feature)
export VAULT_SKIP_VERIFY=false                          # Skip TLS verification for Vault
export CONSUL_ADDR="http://devcontainer-consul:8500"    # Consul service discovery address
export CONSUL_DATACENTER="dc1"                          # Consul datacenter name
export CONSUL_HTTP_TOKEN=""                             # Consul HTTP token (if ACL enabled)

# Cloud provider default regions (must be defined before Terraform variables)
export AWS_DEFAULT_REGION="eu-central-1"                 # AWS default region (Europe Central - Frankfurt)
export GCP_REGION="europe-central2"                      # GCP default region (Europe Central - Warsaw)
export AZURE_LOCATION="poland-central"                   # Azure default region (Europe Central - Warsaw)

# Terraform variables
export TF_VAR_environment="dev"                       # Terraform environment name
export TF_VAR_cost_center="engineering"                  # Terraform cost center tag
export TF_VAR_compliance_level="standard"                # Terraform compliance level
export TF_VAR_enable_aws=true                          # Enable AWS resources in Terraform
export TF_VAR_enable_azure=true                       # Enable Azure resources in Terraform
export TF_VAR_enable_gcp=true                         # Enable GCP resources in Terraform
export TF_VAR_project_name=""                         # Terraform project name (project-specific)
export TF_VAR_aws_region="${AWS_DEFAULT_REGION}"        # AWS region for Terraform
export TF_VAR_azure_region="${AZURE_LOCATION}"          # Azure region for Terraform
export TF_VAR_gcp_region="${GCP_REGION}"                # GCP region for Terraform
export TF_LOG=""                                        # Terraform log level (empty = default)
export TF_LOG_PATH=""                                   # Terraform log file path
export TF_INPUT=true                                    # Terraform interactive input
export TF_IN_AUTOMATION=false                           # Terraform automation mode

# Kubernetes (dev defaults)
export KUBE_CLUSTER_SERVER="https://dev.k8s.local:6443"  # Kubernetes API server URL
export KUBE_USER_NAME="dev-user"                         # Kubernetes user name
export KUBE_CONTEXT_NAME="dev-context"                   # Kubernetes context name
export K8S_STORAGE_CLASS="standard"                      # Kubernetes storage class
export K8S_NAMESPACE="default"                            # Default Kubernetes namespace
export K8S_REGISTRY=""                                   # Container registry URL (project-specific)
export HELM_CHART_VERSION=""                              # Helm chart version (project-specific)
export KUBECTL_DEFAULT_NAMESPACE="default"                # kubectl default namespace

# GraphQL
export GRAPHQL_CORS_ORIGINS="http://localhost:3000,http://localhost:3001"  # Allowed CORS origins for GraphQL
export GRAPHQL_PORT=4000                                                # GraphQL server port
export GRAPHQL_URL="http://devcontainer-graphql:4000"                  # GraphQL service URL

# ============================================================================
# GATEWAY SERVICES (Go service gateways)
# ============================================================================
# Traefik Proxy Gateway
export TRAEFIK_PROXY_PORT=8080                                          # Traefik proxy gateway port
export TRAEFIK_PROXY_URL="http://devcontainer-traefik-proxy:8080"       # Traefik proxy gateway URL
export TRAEFIK_URL="http://devcontainer-traefik:8080"                   # Traefik API URL
export TRAEFIK_WEB_URL="http://devcontainer-traefik:80"                 # Traefik web entrypoint URL
export TRAEFIK_WEBSECURE_URL="http://devcontainer-traefik:443"          # Traefik secure web entrypoint URL
export TRAEFIK_METRICS_URL="http://devcontainer-traefik:9101"           # Traefik metrics URL
export TRAEFIK_DASHBOARD_URL="http://host.docker.internal:8080"          # Traefik dashboard URL (from host)

# Monitoring Gateway
export MONITORING_GATEWAY_PORT=8083                                     # Monitoring gateway port
export MONITORING_GATEWAY_URL="http://devcontainer-monitoring-gateway:8083"  # Monitoring gateway URL

# Database Gateway
export DATABASE_GATEWAY_PORT=8084                                       # Database gateway port
export DATABASE_GATEWAY_URL="http://devcontainer-database-gateway:8084"  # Database gateway URL

# Admin Gateway
export ADMIN_GATEWAY_PORT=8085                                          # Admin gateway port
export ADMIN_GATEWAY_URL="http://devcontainer-admin-gateway:8085"      # Admin gateway URL
export PGADMIN_URL="http://devcontainer-pgadmin:80"                     # pgAdmin URL
export MONGO_EXPRESS_URL="http://devcontainer-mongo-express:8081"      # Mongo Express URL
export REDIS_COMMANDER_URL="http://devcontainer-redis-commander:8081"   # Redis Commander URL

# Elasticsearch Proxy
export ELASTICSEARCH_PROXY_PORT=8087                                    # Elasticsearch proxy port
export ELASTICSEARCH_PROXY_URL="http://devcontainer-elasticsearch-proxy:8087"  # Elasticsearch proxy URL

# Docker/Container settings
# cSpell:ignore crice BUILDKIT
export DOCKER_NETWORK="crice"                             # Docker network name for all services
export DOCKER_COMPOSE_PROJECT_NAME="devcontainer"         # Docker Compose project name
export DOCKER_HOST="unix:///run/user/1000/podman/podman.sock"  # Use Podman socket instead of Docker (user-specific path)
export COMPOSE_DOCKER_CLI_BUILD=1                       # Use Docker CLI for compose builds (better compatibility)
export DOCKER_BUILDKIT=1                                # Enable BuildKit for faster Docker builds

# ============================================================================
# .rice Workspace – generate rice.code-workspace from CUE (static, no seasons)
# ============================================================================
# KING source of truth is infra/config/king_files.cue (package config).
# We export the JSON string stored in king_content["rice.code-workspace"]
# directly into rice.code-workspace (using --out text to avoid extra quoting).
if command -v cue >/dev/null 2>&1; then
  cue export infra/config/king_files.cue -e 'king_content["rice.code-workspace"]' --out text > rice.code-workspace 2>/dev/null \
    && echo "🎨 .rice: Workspace synchronised from CUE"
fi

# ============================================================================
# STORAGE & CDN URLs
# ============================================================================
# Storage service URLs (standardized across projects)
export STORAGE_BASE_URL="http://devcontainer-minio:9000"  # Base storage URL (MinIO)
export STORAGE_PUBLIC_URL=""                              # Public CDN URL (project-specific, set in .env.project)


# ============================================================================
# CONTRACT & BLOCKCHAIN
# ============================================================================
# Contract bridges service (shared across projects)
export CONTRACT_BRIDGES_URL="http://contract-bridges:8080"  # Contract bridges service URL
export CONTRACT_BRIDGES_PORT=8080                         # Contract bridges service port

# CRICE Blockchain (Cosmos SDK)
export CRICE_BLOCKCHAIN_CHAIN_ID="crice"              # Blockchain chain ID
export CRICE_BLOCKCHAIN_MONIKER="crice-node"         # Blockchain node moniker
export CRICE_BLOCKCHAIN_P2P_PORT=26656                    # P2P port
export CRICE_BLOCKCHAIN_RPC_PORT=26657                    # RPC port
export CRICE_BLOCKCHAIN_REST_PORT=1317                    # REST API port
export CRICE_BLOCKCHAIN_GRPC_PORT=9090                    # gRPC port (internal)
export CRICE_BLOCKCHAIN_GRPC_EXTERNAL_PORT=9091          # gRPC external port (mapped)
export CRICE_BLOCKCHAIN_URL="http://devcontainer-crice-blockchain:26657"  # Blockchain RPC URL


# ============================================================================
# PROJECT-SPECIFIC VARIABLES
# ============================================================================
# Note: All cache directories use system defaults (~/.cache, ~/.npm, etc.)
MONOREPO_ROOT="$(pwd)"                       # Absolute path to monorepo root directory
export MONOREPO_ROOT
export PROJECT_ROOT="${MONOREPO_ROOT}/.project"  # Path to projects directory (all projects are here)
export PROJECT_NAME="rice-mono"              # Project identifier/name

# ============================================================================
# WORKSPACE/MONOREPO FILTERS
# ============================================================================
# Workspace configuration
export WORKSPACE_ROOT="${MONOREPO_ROOT}"
export WORKSPACE_PROJECTS_DIR="${PROJECT_ROOT}"
export WORKSPACE_DEVCONTAINER_DIR="${MONOREPO_ROOT}/.devcontainer"

# Project filters (comma-separated list of project slugs to include)
export WORKSPACE_INCLUDE_PROJECTS=""               # e.g., "ceramix,medical,meowtopia"
export WORKSPACE_EXCLUDE_PROJECTS=""              # e.g., "code-rice"

# Build scope
export BUILD_SCOPE="all"                          # all | changed | specific
export BUILD_CHANGED_SINCE="origin/main"          # Git ref for changed detection

# ============================================================================
# TOOL CONFIGURATIONS
# ============================================================================
# Disable telemetry for various tools
export DO_NOT_TRACK=1                        # Universal opt-out flag for tools that respect it
export HOMEBREW_NO_ANALYTICS=1               # Disable Homebrew analytics collection
export GATSBY_TELEMETRY_DISABLED=1           # Disable Gatsby telemetry

# GitHub CLI
export GH_PAGER=less                         # Use less as pager for GitHub CLI output

# ============================================================================
# CORE EXECUTION TOGGLES (global Just pipeline switches)
# These flags control what runs when you use `just`:
# - `just start|launch`   → start Docker/K8s stacks for infra + projects
# - `just log`            → show logs (optionally filtered by service)
# - `just config|install|update` → run toolchain/infra setup
# ============================================================================

# High-level config toggles
# cSpell:ignore FRONTENDS
export CONFIG_SKIP_TOOLCHAIN=false
export CONFIG_SKIP_DOCKER=false
export CONFIG_SKIP_TERRAFORM=false
export CONFIG_SKIP_K8S=false
export CONFIG_SKIP_FRONTENDS=false
export CONFIG_SKIP_CLOUD=false


# ============================================================================
# DEBUG PORTS (Not secrets)
# ============================================================================
# Debug ports for various services and languages
export DEBUG_PORT_NODE=9229                        # Node.js debug port
export DEBUG_PORT_GO=2345                          # Go (Delve) debug port
export DEBUG_PORT_PYTHON=5678                     # Python (debugpy) debug port
export DEBUG_PORT_RUST=9333                       # Rust (LLDB/GDB) debug port
export DEBUG_PORT_JAVA=5005                        # Java debug port
export DEBUG_PORT_NEXTJS=9229                     # Next.js debug port
export DEBUG_PORT_GRAPHQL=4000                    # GraphQL debug port

# VS Code debug adapter ports
export VSCODE_DEBUG_PORT=4711                     # VS Code debug adapter

# Cloud providers
export CONFIG_ENABLE_AWS=true
export CONFIG_ENABLE_AZURE=true
export CONFIG_ENABLE_GCP=true

# ============================================================================
# BUILD & TOOLING SETTINGS
# ============================================================================
# Build configuration
export BUILD_MODE="debug"                          # debug | release | test
BUILD_PARALLEL_JOBS=$(nproc)                       # Number of parallel build jobs
export BUILD_PARALLEL_JOBS
export BUILD_VERBOSE=false                        # Verbose build output

# Bazel settings
export BAZEL_BUILD_OPTS="--config=dev"            # Default Bazel config
export BAZEL_TEST_OPTS="--test_output=errors"     # Bazel test options
export BAZEL_REMOTE_CACHE_ENABLED=false           # Remote cache toggle

# Docker build settings
export DOCKER_BUILD_ARGS=""                       # Additional Docker build args
export DOCKER_COMPOSE_BUILD_ARGS=""               # Additional compose build args

# ============================================================================
# LINTERS/FORMATTERS CONFIG
# ============================================================================
# ESLint
export ESLINT_CACHE=true
export ESLINT_MAX_WARNINGS=0

# Prettier
export PRETTIER_CACHE=true

# Golangci-lint
export GOLANGCI_LINT_CACHE=true

# Rust tools (use default cache locations)
export RUSTFMT_EDITION="2021"                     # Rust edition for formatting

# Python linters (use default cache locations)
export PYLINT_RC_FILE=""                          # Custom pylintrc path (empty = default)
export BLACK_CACHE=true                           # Enable Black formatter cache
export MYPY_CACHE=true                            # Enable mypy cache

# ============================================================================
# OS DETECTION (Platform-specific paths)
# ============================================================================
# Detect OS for platform-specific configurations
if [[ "$OSTYPE" == "linux-gnu"* ]]; then
  export OS_TYPE="linux"
  OS_ARCH=$(uname -m)
  export OS_ARCH
  export CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
  export CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
  export DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
elif [[ "$OSTYPE" == "darwin"* ]]; then
  export OS_TYPE="darwin"
  OS_ARCH=$(uname -m)
  export OS_ARCH
  export CACHE_HOME="$HOME/Library/Caches"
  export CONFIG_HOME="$HOME/Library/Preferences"
  export DATA_HOME="$HOME/Library/Application Support"
elif [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" ]]; then
  export OS_TYPE="windows"
  OS_ARCH=$(uname -m)
  export OS_ARCH
  export CACHE_HOME="${LOCALAPPDATA:-$HOME/AppData/Local}"
  export CONFIG_HOME="${APPDATA:-$HOME/AppData/Roaming}"
  export DATA_HOME="${APPDATA:-$HOME/AppData/Roaming}"
fi

# Platform-specific tool paths
if [[ "$OS_TYPE" == "linux" ]]; then
  # Use Podman socket if available, fallback to Docker
  USER_ID=$(id -u)
  if [[ -S "/run/user/${USER_ID}/podman/podman.sock" ]]; then
    export DOCKER_HOST="unix:///run/user/${USER_ID}/podman/podman.sock"
  else
    export DOCKER_HOST="${DOCKER_HOST:-unix:///var/run/docker.sock}"
  fi
elif [[ "$OS_TYPE" == "darwin" ]]; then
  export DOCKER_HOST="${DOCKER_HOST:-unix:///var/run/docker.sock}"
fi

# Build pipeline toggles
export BUILD_SKIP_TESTS=false
export BUILD_SKIP_BAZEL=false
export BUILD_SKIP_DOCKER=false
export BUILD_SKIP_IMAGES=false
export BUILD_SKIP_NEXT=false
export BUILD_SKIP_FLUTTER=false
export BUILD_SKIP_TERRAFORM=false
export BUILD_SKIP_EXPORTS=false
export BUILD_SKIP_NATIVE=false

# Launch toggles
export LAUNCH_SKIP_INFRA=false
export LAUNCH_SKIP_PROJECTS=false
export LAUNCH_SKIP_WATCHERS=false

# ============================================================================
# TESTING CONFIGURATION
# ============================================================================
# Test settings
export TEST_MODE="unit"                           # unit | integration | e2e | all
export TEST_PARALLEL=true                         # Run tests in parallel
export TEST_VERBOSE=false                         # Verbose test output
export TEST_COVERAGE=true                         # Generate coverage reports
export TEST_COVERAGE_DIR="${MONOREPO_ROOT}/.cache/coverage"
export TEST_TIMEOUT="5m"                          # Test timeout
export TEST_RETRIES=0                             # Number of retries on failure

# Test filtering
export TEST_FILTER=""                             # Test name filter/regex
export TEST_TAGS=""                               # Test tags to include/exclude

# Language-specific test settings
export GO_TEST_FLAGS="-v -race"                   # Go test flags
export NODE_TEST_ENV="test"                       # Node test environment
export PYTEST_ARGS="-v"                           # pytest arguments
export CARGO_TEST_ARGS=""                         # Cargo test arguments

# ============================================================================
# ADDITIONAL TOOL TOGGLES
# ============================================================================
# Development tool toggles
export ENABLE_HOT_RELOAD=true                     # Enable hot reload for dev servers
export ENABLE_SOURCE_MAPS=true                    # Enable source maps in builds
export ENABLE_TYPE_CHECK=true                     # Enable TypeScript type checking
export ENABLE_LINT_ON_SAVE=true                   # Run linters on file save
export ENABLE_FORMAT_ON_SAVE=true                 # Format on save

# Service toggles
export ENABLE_METRICS=true                        # Enable metrics collection
export ENABLE_TRACING=true                        # Enable distributed tracing
export ENABLE_PROFILING=false                     # Enable performance profiling

# Development helpers
export ENABLE_MOCK_SERVICES=true                  # Use mock services instead of real ones
export ENABLE_DEBUG_TOOLBAR=true                  # Enable debug toolbars in web apps

# ============================================================================
# FEATURE FLAGS (Dev Environment)
# ============================================================================
# Development feature flags (enable experimental features in dev)
export FEATURE_NEW_AUTH=false                     # New authentication system
export FEATURE_NEW_DASHBOARD=false                # New dashboard UI
export FEATURE_AI_ASSISTANT=false                 # AI coding assistant features
export FEATURE_EXPERIMENTAL_API=false             # Experimental API endpoints
export FEATURE_BETA_UI=false                      # Beta UI components

# Feature flag management
export FEATURE_FLAGS_FILE="${MONOREPO_ROOT}/.cache/feature-flags.json"

# ============================================================================
# LOG SETTINGS (Not secrets)
# ============================================================================
# Logging configuration
export LOG_LEVEL="debug"                           # debug | info | warn | error
export LOG_FORMAT="json"                           # json | text | pretty
export LOG_OUTPUT="stdout"                         # stdout | file | both
export LOG_FILE="${MONOREPO_ROOT}/.cache/logs/app.log"
export LOG_MAX_SIZE="100MB"                        # Max log file size
export LOG_MAX_FILES=10                            # Max number of log files to keep

# Application-specific log levels
export GO_LOG_LEVEL="${LOG_LEVEL}"
export NODE_LOG_LEVEL="${LOG_LEVEL}"
export PYTHON_LOG_LEVEL="${LOG_LEVEL}"
export RUST_LOG="${LOG_LEVEL}"                    # Rust env_logger

# Structured logging
export LOG_ENABLE_STACKTRACE=true
export LOG_ENABLE_CALLER=true

# Log aggregation (Docker/Compose)
export LOG_SERVICE=""
export LOG_FOLLOW=false
export LOG_TAIL=200
export LOG_SINCE="30m"
export LOG_INCLUDE_K8S=1

# ============================================================================
# SECRETS
# ============================================================================
# Load secrets and sensitive configuration from .env files in order of precedence.
# These files are git-ignored and should contain production credentials, API keys,
# and other sensitive data that should not be committed to version control.
#
# Precedence order (later files override earlier ones):
# 1. .devcontainer/.env - Infrastructure-level secrets
# 2. .project/*/.env - Project-specific secrets
# cSpell:ignore dotenv
dotenv_if_exists .devcontainer/.env
dotenv_if_exists .project/*/.env

# ============================================================================
# COMPLETION
# ============================================================================
# Log success message to confirm environment has been loaded
log_status "✅ Environment loaded successfully!"

# ============================================================================
# DOCKER COMPOSE INTEGRATION
# ============================================================================
# Docker Compose will automatically inherit all exported environment variables
# from this .envrc file when direnv is loaded.
#
# To use docker-compose:
#   1. Ensure direnv is loaded: `direnv allow` (if not already done)
#   2. Run: `docker compose up` (variables will be inherited from shell)
#
# Alternative: Create .env file manually if you need to use docker-compose
# without direnv (not recommended, as .envrc is the source of truth)
