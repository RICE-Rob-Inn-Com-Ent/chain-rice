# Generated — infra/out/cue/env.cue (do not edit by hand).
# Refresh: cue cmd emit ./infra/out/_tool.cue
unset RPROMPT
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
# Chicken-and-egg: only activate pixi after `rice pour` (or `pixi install`) created .pixi/
if [[ -d "$REPO_ROOT/.pixi/envs/default" ]] && command -v pixi >/dev/null 2>&1; then
	eval "$(pixi shell-hook)"
else
	echo "rice: pixi env not ready — run rice pour (Dagger bootstraps Odin body → pixi)" >&2
fi
PATH_add .
PATH_add .bin
export PATH
while IFS= read -r f; do
	[ -z "$f" ] && continue
	case "$f" in
	*.env|*.env.example|*.env.local|*.env.sample|*.env.development|*.env.test)
		envpath="$REPO_ROOT/$f"
		if [ -f "$envpath" ]; then
			dotenv "$envpath"
		fi
		;;
	esac
done < <(git -C "$REPO_ROOT" ls-files 2>/dev/null || true)
watch_file pixi.toml
watch_file pixi.lock
watch_file infra/out/cue/env.cue
watch_file infra/out/cue/pack.cue
