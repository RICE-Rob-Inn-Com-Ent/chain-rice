# ==============================================================================
# DIRENV CONFIGURATION - Rice Monorepo
# ==============================================================================
# Auto-load development environment when entering this directory
# Install: https://direnv.net/
# ==============================================================================

# Enable strict mode
strict_env

# Log direnv activity
log_status "🚀 Loading Rice-Mono development environment..."

# ============================================================================
# PATH EXTENSIONS
# ============================================================================
# Add local bin directories to PATH
PATH_add ./node_modules/.bin
PATH_add ./.venv/bin
PATH_add ./vendor/bin

# ============================================================================
# LANGUAGE VERSIONS
# ============================================================================
# Python
if [ -f .python-version ]; then
  log_status "📦 Loading Python $(cat .python-version)"
  layout python python$(cat .python-version)
fi

# Node.js (requires nvm or asdf)
if [ -f .nvmrc ]; then
  log_status "📦 Loading Node.js $(cat .nvmrc)"
  use node $(cat .nvmrc) 2>/dev/null || log_error "nvm not found or version not installed"
fi

# Ruby (requires rbenv or asdf)
if [ -f .ruby-version ]; then
  log_status "📦 Loading Ruby $(cat .ruby-version)"
  use ruby 2>/dev/null || true
fi

# ============================================================================
# ENVIRONMENT VARIABLES
# ============================================================================
# Development mode
export NODE_ENV=development
export PYTHON_ENV=development
export RUST_ENV=development
export GO_ENV=development

# Bazel optimization
export BAZEL_CXXOPTS="-std=c++17"
export BAZEL_LINKOPTS=""
export USE_BAZEL_VERSION=$(cat .bazelversion 2>/dev/null || echo "7.0.0")

# Python settings
export PYTHONUNBUFFERED=1
export PYTHONDONTWRITEBYTECODE=1
export PIP_REQUIRE_VIRTUALENV=true

# Go settings
export GOPATH="${HOME}/go"
export GO111MODULE=on
export GOPRIVATE="github.com/mrDinkelman"

# Rust settings
export RUST_BACKTRACE=1
export CARGO_INCREMENTAL=1

# Node.js settings
export NODE_OPTIONS="--max-old-space-size=4096"

# Terraform
if [ -f .terraform-version ]; then
  export TF_VERSION=$(cat .terraform-version)
fi

# ============================================================================
# TOOL CONFIGURATIONS
# ============================================================================
# Disable telemetry for various tools
export DO_NOT_TRACK=1
export HOMEBREW_NO_ANALYTICS=1
export NEXT_TELEMETRY_DISABLED=1
export FLUTTER_CLI_TELEMETRY_DISABLED=1
export GATSBY_TELEMETRY_DISABLED=1

# GitHub CLI
export GH_PAGER=less

# Docker
export COMPOSE_DOCKER_CLI_BUILD=1
export DOCKER_BUILDKIT=1

# ============================================================================
# PROJECT-SPECIFIC VARIABLES
# ============================================================================
export PROJECT_ROOT="$(pwd)"
export PROJECT_NAME="rice-mono"

# ============================================================================
# SECRETS (load from .env if exists)
# ============================================================================
dotenv_if_exists .env.local
dotenv_if_exists .env

# ============================================================================
# COMPLETION
# ============================================================================
log_status "✅ Rice-Mono environment loaded successfully!"
log_status "   Python: $(python3 --version 2>/dev/null || echo 'not found')"
log_status "   Node: $(node --version 2>/dev/null || echo 'not found')"
log_status "   Go: $(go version 2>/dev/null | cut -d' ' -f3 || echo 'not found')"
log_status "   Rust: $(rustc --version 2>/dev/null || echo 'not found')"

# ============================================================================
# HELPER FUNCTIONS (optional)
# ============================================================================
# Add custom shell functions for development
# Example: bazel_build() { bazel build //... "$@"; }
