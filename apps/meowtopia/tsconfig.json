{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",

  },
  "include": [
    "admin",
    "main",
    "node",
    "eslint.config.js",
    "postcss.config.js",
    "tailwind.config.js",
  ]
}
