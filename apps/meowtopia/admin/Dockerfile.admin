# Admin Panel Dockerfile
FROM node:18

# Enable Corepack for Yarn version management
RUN corepack enable

WORKDIR /app

# Copy workspace files
COPY package.json yarn.lock .yarnrc.yml ./
COPY app/node/package.json ./app/node/
COPY app/admin/package.json ./app/admin/
COPY app/main/package.json ./app/main/

# Install dependencies
RUN yarn install

# Copy source code
COPY app/admin/ ./app/admin/
COPY app/node/ ./app/node/

# Expose port
EXPOSE 8000

# Start the application in development mode with hot reload
WORKDIR /app/app/admin
CMD ["yarn", "dev", "--port", "8000", "--host", "0.0.0.0"]