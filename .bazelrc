# Bazel configuration for RICE Mono

# Common flags
build --enable_platform_specific_config
build --incompatible_strict_action_env
build --incompatible_enable_cc_toolchain_resolution

# Cache configuration
build --disk_cache=/mnt/ssd/cache/bazel
build --repository_cache=/mnt/ssd/cache/bazel/repository

# Remote cache (optional - for team collaboration)
# build --remote_cache=grpc://cache.rice-mono.local:9092

# Build optimization
build --jobs=auto
build --loading_phase_threads=auto

# Proto compilation
build --proto_compiler=@com_google_protobuf//:protoc
build --proto_toolchain_for_cc=@com_google_protobuf//:cc_toolchain
build --proto_toolchain_for_java=@com_google_protobuf//:java_toolchain

# Go configuration
build --@io_bazel_rules_go//go/config:pure
build --@io_bazel_rules_go//go/config:static

# Test configuration
test --test_output=errors
test --test_summary=detailed

# Performance
build --experimental_reuse_sandbox_directories
build --experimental_inmemory_jdeps_files
build --experimental_inmemory_dotd_files

# GPU support (CUDA)
build:gpu --define=using_cuda=true
build:gpu --define=using_cuda_nvcc=true
build:gpu --crosstool_top=@local_config_cuda//crosstool:toolchain
build:gpu --define=using_cuda_clang=false

# Development mode
build:dev --compilation_mode=dbg
build:dev --strip=never

# Production mode
build:prod --compilation_mode=opt
build:prod --strip=always
build:prod --define=release=true

# Coverage
coverage --combined_report=lcov
coverage --experimental_generate_llvm_lcov

# Platform-specific configs
build:linux --cxxopt=-std=c++17
build:macos --cxxopt=-std=c++17
build:windows --cxxopt=/std:c++17
