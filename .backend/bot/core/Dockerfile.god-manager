# God Manager Dockerfile
FROM python:3.11-slim

WORKDIR /app

# Install dependencies
RUN pip install --no-cache-dir \
    fastapi \
    uvicorn[standard] \
    httpx \
    pydantic

# Copy god manager
COPY god-manager.py /app/server.py

# Expose port
EXPOSE 8100

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8100/').read()"

# Start server
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8100"]

