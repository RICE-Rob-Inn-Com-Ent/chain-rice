#!/usr/bin/env bash
# rice — Dagger entrypoint for SMITH CI (service/ci). All steps run via dagger call.

set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  rice pipeline               # pour → perform → forge → think → prepare → cook → audit → serve
  rice pour
  rice perform
  rice forge
  rice think
  rice audit
  rice prepare <project>
  rice cook <project>
  rice serve <project>

CHIEF projects (pipeline): RICE_CHIEF_PROJECTS="code-rice.com egos.app"
Requires Dagger CLI: https://docs.dagger.io/
EOF
}

ensure_repo_root() {
  if git rev-parse --show-toplevel >/dev/null 2>&1; then
    git rev-parse --show-toplevel
  else
    echo "error: run rice from inside the rice repo" >&2
    exit 1
  fi
}

ensure_dagger() {
  if ! command -v dagger >/dev/null 2>&1; then
    echo "error: dagger CLI not found on PATH." >&2
    echo "       Install: https://docs.dagger.io/install" >&2
    exit 1
  fi
}

require_project() {
  local cmd="$1"
  local project="${2:-}"
  if [[ -z "$project" ]]; then
    echo "error: missing project name for 'rice ${cmd}'." >&2
    usage
    exit 1
  fi
  printf '%s' "$project"
}

run_dagger() {
  local root
  root="$(ensure_repo_root)"
  cd "$root"
  dagger call "$@"
}

chief_projects() {
  # shellcheck disable=SC2086
  printf '%s\n' ${RICE_CHIEF_PROJECTS:-code-rice.com egos.app}
}

run_pipeline() {
  ensure_dagger
  local root p
  root="$(ensure_repo_root)"
  cd "$root"

  echo "══ rice pipeline: pour ══"
  dagger call pour

  echo "══ rice pipeline: perform ══"
  dagger call perform

  echo "══ rice pipeline: forge ══"
  dagger call forge

  echo "══ rice pipeline: think ══"
  dagger call think

  while IFS= read -r p; do
    [[ -n "$p" ]] || continue
    echo "══ rice pipeline: prepare ${p} ══"
    dagger call prepare --project "$p"
  done < <(chief_projects)

  while IFS= read -r p; do
    [[ -n "$p" ]] || continue
    echo "══ rice pipeline: cook ${p} ══"
    dagger call cook --project "$p"
  done < <(chief_projects)

  echo "══ rice pipeline: audit ══"
  dagger call audit

  while IFS= read -r p; do
    [[ -n "$p" ]] || continue
    echo "══ rice pipeline: serve ${p} ══"
    dagger call serve --project "$p"
  done < <(chief_projects)

  echo "✅ rice pipeline complete"
}

main() {
  local subcmd="${1:-}"
  shift || true

  case "$subcmd" in
    pipeline)
      run_pipeline
      ;;
    pour|perform|forge|think|audit)
      ensure_dagger
      run_dagger "$subcmd"
      ;;
    cook|serve|prepare)
      ensure_dagger
      local project
      project="$(require_project "$subcmd" "${1:-}")"
      run_dagger "$subcmd" --project "$project"
      ;;
    -h|--help|help)
      usage
      ;;
    "")
      echo "error: missing subcommand." >&2
      usage
      exit 1
      ;;
    *)
      echo "error: unknown subcommand '$subcmd'." >&2
      usage
      exit 1
      ;;
  esac
}

main "$@"
