// Prisma Schema for Meowtopia
// Unified schema for PostgreSQL and MongoDB synchronization
// PostgreSQL: Primary database managed by Prisma
// MongoDB: Synchronized via migrate-to-both-dbs.ts for faster queries

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  username      String?   @unique // Unikalna nazwa użytkownika dla URL
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(CUSTOMER)
  firstName     String?
  lastName      String?
  phone         String?
  dateOfBirth   DateTime?
  address       Json?     // adres domowy
  preferences   Json?     // preferencje użytkownika
  loyaltyPoints Int       @default(0)
  totalSpent    Decimal   @db.Decimal(10, 2) @default(0)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  cart          Cart?
  reviews       ProductReview[]
  blogPosts     BlogPost[]

  @@index([role])
  @@index([loyaltyPoints])
  @@index([username])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// E-commerce models
enum UserRole {
  CUSTOMER
  ADMIN
  MANAGER
  OWNER
  VOLUNTEER
  ARTIST
}

// Model kategorii produktów - dynamiczne kategorie zarządzane przez owner/manager
model Category {
  id          String    @id @default(cuid())
  name        String    @unique // Nazwa kategorii (np. "Kawa", "Herbata")
  slug        String    @unique // URL-friendly slug (np. "kawa", "herbata")
  description String?
  icon        String?   // Opcjonalna ikona/emoji dla kategorii
  active      Boolean   @default(true)
  order       Int       @default(0) // Kolejność wyświetlania
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([active, order])
  @@index([slug])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  BLIK
  PRZELEWY24
  BANK_TRANSFER
}

enum ShippingMethod {
  INPOST_PACZKOMAT
  INPOST_KURIER
  ORLEN_PACZKA
  COURIER_STANDARD
  PICKUP
}

// Modele produktów
model Product {
  id              String          @id @default(cuid())
  name            String
  description     String?
  shortDescription String?
  price           Decimal         @db.Decimal(10, 2)
  categoryId      String
  category        Category         @relation(fields: [categoryId], references: [id])
  images          String[]        @default([])
  stock           Int             @default(0)
  featured        Boolean         @default(false)
  specialOffer    Boolean         @default(false) // Oferta specjalna - tylko owner/manager może ustawić
  isBundle        Boolean         @default(false) // Czy to zestaw produktów
  active          Boolean         @default(true)
  weight          Decimal?        @db.Decimal(8, 2) // waga w gramach
  dimensions      Json?           // {"width": 10, "height": 15, "depth": 5}
  tags            String[]        @default([])
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  orderItems      OrderItem[]
  cartItems       CartItem[]
  reviews         ProductReview[]
  bundleProducts  BundleProduct[] @relation("BundleProducts")
  componentOf     BundleProduct[] @relation("ComponentProducts")

  @@index([categoryId, active])
  @@index([featured, active])
  @@index([specialOffer, active])
  @@index([isBundle, active])
}

// Relacja między zestawami a produktami składowymi
model BundleProduct {
  id        String   @id @default(cuid())
  bundleId  String   // ID produktu-zestawu
  productId String  // ID produktu składowego
  quantity  Int      @default(1) // Ilość danego produktu w zestawie
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  bundle  Product @relation("BundleProducts", fields: [bundleId], references: [id], onDelete: Cascade)
  product Product @relation("ComponentProducts", fields: [productId], references: [id], onDelete: Cascade)

  @@unique([bundleId, productId])
  @@index([bundleId])
  @@index([productId])
}

// Opinie o produktach
model ProductReview {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int      @db.SmallInt // 1-5
  comment   String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
}

// Model zamówienia
model Order {
  id              String          @id @default(cuid())
  orderNumber     String          @unique
  userId          String
  status          OrderStatus     @default(PENDING)
  paymentStatus   PaymentStatus   @default(PENDING)
  subtotal        Decimal         @db.Decimal(10, 2)
  shippingCost    Decimal         @db.Decimal(10, 2) @default(0)
  total           Decimal         @db.Decimal(10, 2)
  donationAmount  Decimal         @db.Decimal(10, 2) @default(0) // 5% na fundacje
  shippingMethod  ShippingMethod?
  shippingAddress Json?           // adres dostawy
  notes           String?
  trackingNumber  String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id])
  items           OrderItem[]
  payment         Payment?
  donationRecord  DonationRecord?

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2) // cena w momencie zamówienia
  total     Decimal @db.Decimal(10, 2) // quantity * price
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
}

// Model płatności
model Payment {
  id              String        @id @default(cuid())
  orderId         String        @unique
  paymentMethod   PaymentMethod
  amount          Decimal       @db.Decimal(10, 2)
  status          PaymentStatus @default(PENDING)
  transactionId   String?       // ID transakcji z systemu płatności
  externalId      String?       // zewnętrzne ID płatności
  paymentData     Json?         // dodatkowe dane płatności
  failureReason   String?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  order           Order         @relation(fields: [orderId], references: [id])

  @@index([status])
  @@index([transactionId])
}

// Koszyk
model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique // null dla anonimowych użytkowników
  sessionId String?    @unique // dla anonimowych sesji
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@index([sessionId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  addedAt   DateTime @default(now())
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

// Fundacje i darowizny
model Foundation {
  id              String           @id @default(cuid())
  name            String
  description     String
  website         String?
  logo            String?
  email           String?           @unique // Email do logowania
  passwordHash    String?          // Hash hasła do logowania
  active          Boolean          @default(true)
  featured        Boolean          @default(false)
  totalReceived   Decimal          @db.Decimal(10, 2) @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  donationRecords DonationRecord[]

  @@index([active, featured])
  @@index([email])
}

model DonationRecord {
  id           String     @id @default(cuid())
  orderId      String     @unique
  foundationId String
  amount       Decimal    @db.Decimal(10, 2)
  status       String     @default("pending") // pending, transferred, failed
  transferDate DateTime?
  notes        String?
  createdAt    DateTime   @default(now())
  order        Order      @relation(fields: [orderId], references: [id])
  foundation   Foundation @relation(fields: [foundationId], references: [id])

  @@index([foundationId])
  @@index([status])
}

// Newsletter
model Newsletter {
  id          String   @id @default(cuid())
  email       String   @unique
  active      Boolean  @default(true)
  firstName   String?
  lastName    String?
  preferences Json?    // preferencje tematów
  subscribedAt DateTime @default(now())
  unsubscribedAt DateTime?

  @@index([active])
}

// Blog
model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String
  featuredImage String?
  published   Boolean  @default(false)
  seoTitle    String?
  seoDescription String?
  tags        String[] @default([])
  authorId    String
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  author      User     @relation(fields: [authorId], references: [id])

  @@index([published, publishedAt])
  @@index([slug])
}

// Analytics models
// Statystyki z mediów społecznościowych
model SocialMediaStats {
  id            String   @id @default(cuid())
  platform      String   // facebook, instagram, twitter
  followers     Int      @default(0)
  likes         Int      @default(0)
  comments      Int      @default(0)
  shares        Int      @default(0)
  engagementRate Decimal? @db.Decimal(5, 2)
  lastUpdated   DateTime @default(now()) @updatedAt
  createdAt     DateTime @default(now())
  
  @@unique([platform])
  @@index([platform, lastUpdated])
}

// Ruch na stronie
model WebsiteTraffic {
  id                String   @id @default(cuid())
  date              DateTime @default(now())
  visitors          Int      @default(0)
  pageViews         Int      @default(0)
  sessions          Int      @default(0)
  bounceRate        Decimal? @db.Decimal(5, 2)
  avgSessionDuration Int?    // w sekundach
  source            String?  // organic, direct, social, etc.
  createdAt         DateTime @default(now())
  
  @@index([date])
  @@index([source, date])
}

// Ustawienia sklepu (m.in. próg darmowej dostawy)
model StoreSettings {
  id                     String   @id @default(cuid())
  freeShippingThreshold  Decimal  @db.Decimal(10, 2) @default(199.00)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}


