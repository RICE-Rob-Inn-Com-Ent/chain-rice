# Example Terraform variables for Ceramix
# Copy this file to terraform.tfvars and adjust values

image_tag      = "latest"
node_env       = "development"
base_url       = "http://ceramix.ltd"
expose_ports   = false

postgres_host     = "devcontainer-postgres"
postgres_port     = "5432"
postgres_user     = "ceramix_user"
postgres_password = "your_password_here"
postgres_db       = "ceramix"

# Full connection URL (if provided, individual postgres_* vars are ignored)
# database_url = "postgresql://ceramix_user:password@devcontainer-postgres:5432/ceramix"










































