# MASON-generated Buck2 manifest — do not edit by hand.
# Source: infra/build/cue/base.cue — watches base/contract
# Rebuild: buck2 build '//base/contract:check'

genrule(
    name = "check",
    srcs = glob(["src/**/*.rs", "Cargo.toml", "../Cargo.toml"]),
    out = "check.stamp",
    cmd = """
set -euo pipefail
REPO=$(git rev-parse --show-toplevel)
export PATH="$REPO/.pixi/envs/default/bin:$HOME/.cargo/bin:/usr/bin:$PATH"
cd "$REPO/base"
if [ -f Cargo.lock ]; then
  cargo build -p contract --locked
else
  cargo build -p contract
fi
touch "$OUT"
""",
    visibility = ["PUBLIC"],
)

