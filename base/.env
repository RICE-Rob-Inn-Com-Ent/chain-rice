# CLERK — `base/` runtime (keys used by Rust/Zig/Haskell under this tree).
# Optional: copy to `base/.env.local` and load with direnv; do not commit secrets.
# Buck `base/*/BUCK` genrules set `CARGO_TARGET_DIR` (and Zig caches for `bench`) under `buck-out/clerk-artifacts/` when unset.

# --- Cargo / Buck artifact dirs (optional overrides) ---
# CARGO_TARGET_DIR=
# CLERK_ARTIFACT_ROOT=

# --- Haskell CALC FFI (`util` calc-bridge) ---
# Path to librice_calc_ffi.so from `cd base/calc && cabal build foreign-library:rice_calc_ffi`
# RICE_CALC_LIB=
# RICE_CALC_USE_BINARY=0

# --- Zig static lib for `util` zig-warden (`util/build.rs`) ---
# RICE_CLERK_SECURITY_LIB_DIR=

# --- Bench / LSP (`bench`, `mint`) ---
# RICE_BENCH_BIN=
# RICE_LSP_PERF=
# RICE_BENCH_RUN_ZIG=0

# --- Policies (optional integrations) ---
# RICE_USE_CALC_FFI=0
# RICE_POLICY_PARALLEL=
# RICE_POLICY_AUDIT_LOG=
# RICE_POLICY_AUDIT_SUBJECT=
# NATS_URL=nats://127.0.0.1:4222
# RICE_POLICY_BLOCK_HEIGHT=
# RICE_MASON_XML_NAMESPACE=
# RICE_CLERK_CW_API_VERSION=clerk.policy.v1

# --- Private / ZK ---
# RICE_ZK_MOCK_VERIFY=
# RICE_ZK_POLICY_ROOT=
# RICE_ZK_THRESHOLD=
# RICE_ZK_NULLIFIER_COLLECTION=
# RICE_ZK_TRUSTED_SETUP_PATH=

