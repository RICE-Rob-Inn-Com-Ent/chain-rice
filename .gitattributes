*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary

# ============================================================================
# LOCK FILES (Don't diff, they're generated)
# ============================================================================
package-lock.json -diff
yarn.lock -diff
pnpm-lock.yaml -diff
Cargo.lock -diff
Gemfile.lock -diff
Pipfile.lock -diff
poetry.lock -diff
go.sum -diff
composer.lock -diff
pubspec.lock -diff

# ============================================================================
# GENERATED FILES (linguist-generated)
# ============================================================================
# Bazel
bazel-* linguist-generated

# Protocol Buffers generated
*.pb.go linguist-generated
*_pb2.py linguist-generated
*_pb2_grpc.py linguist-generated

# Vendored dependencies
vendor/** linguist-vendored
node_modules/** linguist-vendored
Pods/** linguist-vendored

# Minified files
*.min.js linguist-generated
*.min.css linguist-generated

# ============================================================================
# LINE ENDING EXCEPTIONS
# ============================================================================
# Windows-specific files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# ============================================================================
# MERGE STRATEGIES
# ============================================================================
# Use union merge for changelog
CHANGELOG.md merge=union

# ============================================================================
# DIFF CONFIGURATION
# ============================================================================
# Custom diff patterns for better diffs
*.go diff=golang
*.rs diff=rust
*.swift diff=swift
*.kt diff=kotlin

# ============================================================================
# EXPORT IGNORE (for git archive)
# ============================================================================
.gitattributes export-ignore
.gitignore export-ignore
.github export-ignore
.vscode export-ignore
.idea export-ignore
tests export-ignore
test export-ignore
*.test.* export-ignore
*.spec.* export-ignore
