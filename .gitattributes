# .gitattributes
# Generated by: cue export infra/configs/gitattributes.cue
# Do not edit manually — edit infra/configs/gitattributes.cue instead

# ── global default ────────────────────────────────────────
* text=auto

# ── MASON — CUE + Proto + docs ────────────────────────────
*.cue   text eol=lf
*.proto text eol=lf
*.md    text eol=lf diff=markdown

# ── SMITH — Go + Elixir ───────────────────────────────────
*.go    text eol=lf diff=golang
*.ex    text eol=lf
*.exs   text eol=lf

# ── SAGE — Python + Mojo ──────────────────────────────────
*.py    text eol=lf diff=python
*.mojo  text eol=lf

# ── BARD — Odin + TypeScript + Dart ──────────────────────
*.odin              text eol=lf
*.{js,jsx,ts,tsx}   text eol=lf
*.{mjs,cjs}         text eol=lf
*.dart              text eol=lf

# ── CLERK — Rust + Haskell + Zig ─────────────────────────
*.rs    text eol=lf diff=rust
*.hs    text eol=lf
*.lhs   text eol=lf
*.zig   text eol=lf

# ── CHIEF — .rice language + compiler ────────────────────
*.rice  text eol=lf

# ── build system — tab sensitive ─────────────────────────
justfile    text eol=lf
BUCK        text eol=lf
BUCK2       text eol=lf
.buckversion text eol=lf

# ── config formats ────────────────────────────────────────
*.toml              text eol=lf
*.{yaml,yml}        text eol=lf
*.{json,jsonc}      text eol=lf
*.{tf,tfvars}       text eol=lf
*.{html,css,scss}   text eol=lf
*.{sh,bash,zsh}     text eol=lf
*.sql               text eol=lf
*.txt               text eol=lf

# ── Windows scripts — crlf only ──────────────────────────
*.{ps1,bat,cmd}     text eol=crlf

# ── secrets — never diff ──────────────────────────────────
*.enc.env           binary -diff
*.pem               binary -diff
*.key               binary -diff
*.p12               binary -diff

# ── binary — images ───────────────────────────────────────
*.{png,jpg,jpeg,gif,ico,webp}   binary
*.svg                           text eol=lf
*.{ttf,otf,woff,woff2}          binary

# ── binary — archives ─────────────────────────────────────
*.{zip,tar,gz,zst,xz,bz2}       binary
*.{exe,dll,so,dylib}            binary

# ── binary — compiled ─────────────────────────────────────
*.pyc           binary
*.class         binary
*.jar           binary
*.pdf           binary -diff
*.wasm          binary

# ── lock files — no diff noise ────────────────────────────
bun.lockb       binary -diff
Cargo.lock      text eol=lf -diff
go.sum          text eol=lf -diff
pubspec.lock    text eol=lf -diff
pixi.lock       text eol=lf -diff
mix.lock        text eol=lf -diff

# ── generated — linguist ──────────────────────────────────
*.pb.go             linguist-generated
buck-out/**         linguist-generated
infra/docs/site/**  linguist-generated

