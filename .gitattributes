# ============================================================================
# RICE-MONO GITATTRIBUTES - Enterprise Monorepo Configuration
# ============================================================================
# Auto detect text files and perform LF normalization
* text=auto

# ============================================================================
# SOURCE CODE
# ============================================================================
# Go
*.go text eol=lf diff=go

# Python
*.py text eol=lf diff=python
*.pyi text eol=lf diff=python
*.pyx text eol=lf
*.pxd text eol=lf

# Rust
*.rs text eol=lf diff=rust
*.toml text eol=lf

# JavaScript / TypeScript
*.js text eol=lf diff=javascript
*.jsx text eol=lf diff=javascript
*.ts text eol=lf diff=typescript
*.tsx text eol=lf diff=typescript
*.mjs text eol=lf
*.cjs text eol=lf

# Java / Kotlin
*.java text eol=lf diff=java
*.kt text eol=lf
*.kts text eol=lf
*.gradle text eol=lf
*.gradle.kts text eol=lf

# Swift
*.swift text eol=lf diff=swift

# Dart
*.dart text eol=lf

# C / C++
*.c text eol=lf diff=cpp
*.h text eol=lf diff=cpp
*.cpp text eol=lf diff=cpp
*.hpp text eol=lf diff=cpp
*.cc text eol=lf diff=cpp
*.cxx text eol=lf diff=cpp

# C#
*.cs text eol=lf diff=csharp
*.csx text eol=lf diff=csharp

# PHP
*.php text eol=lf diff=php

# Solidity
*.sol text eol=lf

# Protobuf
*.proto text eol=lf

# ============================================================================
# MARKUP / CONFIGURATION
# ============================================================================
# HTML / CSS
*.html text eol=lf diff=html
*.htm text eol=lf diff=html
*.css text eol=lf diff=css
*.scss text eol=lf diff=css
*.sass text eol=lf
*.less text eol=lf

# XML
*.xml text eol=lf
*.xsl text eol=lf
*.xsd text eol=lf

# YAML
*.yaml text eol=lf
*.yml text eol=lf

# JSON
*.json text eol=lf
*.jsonc text eol=lf

# TOML
*.toml text eol=lf

# INI
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.config text eol=lf

# Markdown
*.md text eol=lf diff=markdown
*.markdown text eol=lf diff=markdown
*.mdown text eol=lf
*.mkd text eol=lf
*.mkdn text eol=lf

# ============================================================================
# INFRASTRUCTURE / DEVOPS
# ============================================================================
# Docker
Dockerfile text eol=lf
*.dockerfile text eol=lf
.dockerignore text eol=lf

# Terraform
*.tf text eol=lf
*.tfvars text eol=lf

# Ansible
*.playbook text eol=lf

# Kubernetes
*.k8s text eol=lf

# Bazel
*.bzl text eol=lf
*.bazel text eol=lf
BUILD text eol=lf
WORKSPACE text eol=lf
MODULE.bazel text eol=lf

# ============================================================================
# SHELL SCRIPTS
# ============================================================================
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.fish text eol=lf
*.ps1 text eol=crlf

# Makefile
Makefile text eol=lf
*.mk text eol=lf
*.make text eol=lf

# ============================================================================
# DOCUMENTATION
# ============================================================================
*.txt text eol=lf
*.adoc text eol=lf
*.textile text eol=lf
*.mustache text eol=lf
*.csv text eol=lf
*.tab text eol=lf
*.tsv text eol=lf
*.sql text eol=lf

AUTHORS text eol=lf
CHANGELOG text eol=lf
CHANGES text eol=lf
CONTRIBUTING text eol=lf
COPYING text eol=lf
COPYRIGHT text eol=lf
*COPYRIGHT* text eol=lf
INSTALL text eol=lf
LICENSE text eol=lf
NEWS text eol=lf
README text eol=lf
*README* text eol=lf
TODO text eol=lf

