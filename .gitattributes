*.ico binary
*.svg text
*.webp binary
*.bmp binary
*.tiff binary
*.tif binary

# Fonts
*.ttf binary
*.otf binary
*.eot binary
*.woff binary
*.woff2 binary

# Audio
*.mp3 binary
*.ogg binary
*.wav binary
*.flac binary

# Video
*.mp4 binary
*.webm binary
*.avi binary
*.mov binary
*.mkv binary

# Archives
*.zip binary
*.tar binary
*.gz binary
*.bz2 binary
*.7z binary
*.rar binary

# Compiled binaries
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.class binary
*.pyc binary
*.pyo binary
*.o binary
*.obj binary
*.a binary
*.lib binary

# Packages
*.jar binary
