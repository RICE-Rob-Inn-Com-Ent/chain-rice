# .buckconfig
# Generated by: cue export infra/configs/buck.cue
# Do not edit manually — edit infra/configs/buck.cue instead

[repositories]
    root = .

[repository_aliases]
    # monorepo domains — each maps to a BUCK file
    base     = base/
    service  = service/
    frontend = frontend/
    function = function/
    infra    = infra/
    custom   = custom/

[build]
    # parallelize across all cores — applies to ALL domains
    threads                 = 0
    engine                  = buck2
    # execution platform — where build actions run (local by default)
    # flip to RE when remote execution cluster is available
    execution_platforms     = root//infra/platforms:default
    default_target_platform = root//infra/platforms:default

[alias]
    # ── full kingdom ──────────────────────────────────────
    all     = //...
    king    = //base/mint/...
    mason   = //infra/...
    smith   = //service/...
    sage    = //function/...
    bard    = //frontend/...
    clerk   = //base/...
    chief   = //base/mint/... //custom/...

# ============================================================
# TODO:
# [ ] write infra/platforms/BUILD — default execution platform
#     execution_platform_rule for linux, macos, windows
#     remote_execution_platform when RICE_RE_ENABLED=true
# [ ] write infra/toolchains/BUILD — per-language toolchain declarations
#     go_toolchain: reads GOROOT from pixi env
#     rust_toolchain: reads RUSTUP_HOME from pixi env
#     python_toolchain: reads .pixi/envs/default/bin/python
#     zig_toolchain: reads zig path from pixi env
# [ ] write base/mint/BUCK — rust_binary for the .rice compiler
#     name = "mint", srcs = glob(["src/**/*.rs"]), edition = "2021"
#     this is the CHIEF's engine — depended on by custom/*/BUCK targets
# [ ] write custom/BUCK — filegroup target that aggregates all 🚚 artifacts
#     name = "rice-bundle" → output matches the 🚚 file in repo root
#     depends_on: all role binaries + mint + config exports + model registry
# [ ] add [buck2] section when RE cluster available:
#     execution_platforms = //infra/platforms:remote
#     RE endpoint read from RICE_RE_ENDPOINT env var
# [ ] add [cache] remote section when cache server available:
#     http = RICE_BUCK_CACHE_URL env var
#     mode = dir + http (hybrid)
# ============================================================

[cache]
    # local disk cache — survives restarts
    mode            = dir
    dir             = .buck-cache
    dir_max_size_gb = 20

[remoteexecution]
    # flip to true when RE cluster is available
    enabled = false

[download]
    # max parallel fetch jobs
    max_number_of_http_connections = 16

[parser]
    # polyglot monorepo — enable all rule providers
    target_platform_detector_spec = target:root//...->root//infra/platforms:default
    default_host_platform         = root//infra/platforms:default

[project]
    # never touch these — generated or sensitive
    ignore = \
        .git, \
        .envrc, \
        .rice-model, \
        .rice-model-base, \
        .rice-hardware.json, \
        .rice-compute.json, \
        secrets.enc.env, \
        node_modules, \
        __pycache__, \
        .dart_tool, \
        .pub-cache, \
        _build, \
        deps, \
        .pixi, \
        buck-out, \
        .buck-cache

[go]
    # SMITH — Go + Elixir microservices
    root       = service/
    vendor     = service/vendor/
    cover_tool = cover
    go_flags   = -mod=vendor

[rust]
    # CLERK — Rust + Zig + Haskell (base/)
    # CHIEF — mint compiler (base/mint/)
    edition     = 2021
    rustc_flags = -D warnings

[python]
    # SAGE — Python + Mojo agents + pipelines
    interpreter   = .pixi/envs/default/bin/python
    version       = 3.12
    package_style = inplace

[cxx]
    # BARD — Odin uses C interop (frontend/vendor/)
    default_platform = linux-x86_64
    combined_preproc = true

[test]
    timeout_ms              = 60000
    parallel                = true
    always_show_test_output = true

[log]
    max_traces          = 50
    chrome_trace_format = true

[ui]
    show_progress            = true
    thread_line_limit        = 16
    show_full_failed_command = true

[cells]
    toolchains = toolchains//
