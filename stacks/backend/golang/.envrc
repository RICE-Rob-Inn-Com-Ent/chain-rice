#!/bin/bash
# 🚀 Go Environment для стеку (запобігає створенню кешів в корені)

# Отримати абсолютний шлях до Go стеку
GO_STACK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Встановити Go змінні для цього стеку
export GOPATH="$GO_STACK_DIR"
export GOBIN="$GO_STACK_DIR/bin"
export GOCACHE="$GO_STACK_DIR/.cache/go-build"
export GOMODCACHE="$GO_STACK_DIR/pkg/mod"

# Створити папки якщо не існують
mkdir -p "$GOBIN" "$GOCACHE" "$GOMODCACHE"

# Додати Go bin до PATH
export PATH="$GOBIN:$PATH"

echo "🚀 Go environment налаштовано для стеку:"
echo "   GOPATH=$GOPATH"
echo "   GOBIN=$GOBIN" 
echo "   GOCACHE=$GOCACHE"
echo "   GOMODCACHE=$GOMODCACHE"
