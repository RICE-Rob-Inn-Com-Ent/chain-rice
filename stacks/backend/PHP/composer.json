{
  "name": "chainrice/bridge",
  "description": "Bridge library for connecting PHP applications to ChainRice Go services",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "ChainRice Team",
      "email": "dev@chain-rice.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "guzzlehttp/guzzle": "^7.8",
    "grpc/grpc": "^1.58.0",
    "google/protobuf": "^3.25.1",
    "monolog/monolog": "^3.5",
    "symfony/config": "^7.0",
    "symfony/dependency-injection": "^7.0",
    "symfony/http-client": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.10",
    "squizlabs/php_codesniffer": "^3.7"
  },
  "autoload": {
    "psr-4": {
      "ChainRice\\Bridge\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ChainRice\\Bridge\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "cs-check": "phpcs",
    "cs-fix": "phpcbf",
    "stan": "phpstan analyse"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "composer/package-versions-deprecated": true
    }
  }
}
