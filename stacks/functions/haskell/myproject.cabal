cabal-version:       3.4
name:                myproject
version:             0.1.0.0
build-type:          Simple

executable myproject
  main-is:             Main.hs
  hs-source-dirs:      src
  default-language:    Haskell2010
  ghc-options:         -Wall
  build-depends:       base >=4.14 && <5
  other-modules:       Utils


