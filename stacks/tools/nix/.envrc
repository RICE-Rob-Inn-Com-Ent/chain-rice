# ChainRice Nix Development Environment
# This file enables automatic environment loading with direnv

# Use the Nix flake
use flake

# Additional environment setup
export CHAINRICE_NIX_ENV=1
export CHAINRICE_ROOT="$PWD/../.."

# Development shortcuts
alias nix-go="nix develop .#go"
alias nix-react="nix develop .#react" 
alias nix-nextjs="nix develop .#nextjs"
alias nix-rust="nix develop .#rust"
alias nix-proto="nix develop .#proto"
alias nix-julia="nix develop .#julia"
alias nix-python="nix develop .#python"
alias nix-infra="nix develop .#infra"

# Quick navigation
alias goto-backend="cd $CHAINRICE_ROOT/backend"
alias goto-frontend="cd $CHAINRICE_ROOT/frontend"
alias goto-functions="cd $CHAINRICE_ROOT/functions"
alias goto-infra="cd $CHAINRICE_ROOT/infrastructure"

echo "🌾 ChainRice Nix environment loaded!"
echo "Use 'nix-go', 'nix-react', 'nix-nextjs', 'nix-rust', 'nix-proto', 'nix-julia', 'nix-python', or 'nix-infra' for stack-specific shells"
