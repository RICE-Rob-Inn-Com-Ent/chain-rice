FROM golang:1.21-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git build-base linux-headers

WORKDIR /app

# Initialize go module if it doesn't exist
RUN go mod init cosmos-app || true

# Install Cosmos SDK and related dependencies
RUN go get github.com/cosmos/cosmos-sdk@latest && \
    go get github.com/cosmos/ibc-go/v7@latest && \
    go get github.com/cometbft/cometbft@latest && \
    go get github.com/cosmos/cosmos-proto@latest && \
    go get github.com/cosmos/gogoproto@latest && \
    go get github.com/grpc-ecosystem/grpc-gateway@latest && \
    go get google.golang.org/grpc@latest && \
    go get google.golang.org/protobuf@latest

# Copy application files if they exist
COPY go.mod go.sum ./
RUN go mod download || true

COPY . .

# Build the application (with fallback to a simple server if no main.go exists)
RUN if [ -f main.go ]; then \
    CGO_ENABLED=0 GOOS=linux go build -o main .; \
    else \
    echo 'package main\n\nimport (\n\t"fmt"\n\t"net/http"\n\t"log"\n)\n\nfunc main() {\n\thttp.HandleFunc("/", func(w http.ResponseWriter, r *http.Request) {\n\t\tfmt.Fprintf(w, "Cosmos SDK Go Container is running!")\n\t})\n\tlog.Println("Server starting on :8080")\n\tlog.Fatal(http.ListenAndServe(":8080", nil))\n}' > main.go && \
    CGO_ENABLED=0 GOOS=linux go build -o main .; \
    fi

FROM alpine:latest

# Install runtime dependencies
RUN apk --no-cache add ca-certificates curl jq

WORKDIR /root/

# Copy the binary
COPY --from=builder /app/main .

# Create directories for Cosmos SDK
RUN mkdir -p /root/.cosmos && \
    mkdir -p /root/config

EXPOSE 8080 26656 26657 1317 9090

CMD ["./main"]
