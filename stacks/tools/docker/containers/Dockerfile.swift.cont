FROM swift:5.9 AS builder

WORKDIR /app

COPY Package.swift .
RUN swift package resolve

COPY . .
RUN swift build -c release

FROM ubuntu:22.04
RUN apt-get update && apt-get install -y libssl3 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app/.build/release/app .

EXPOSE 8080

CMD ["./app"]
