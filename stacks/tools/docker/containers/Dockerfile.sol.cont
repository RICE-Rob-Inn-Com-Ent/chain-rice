FROM ethereum/solc:stable AS builder

WORKDIR /app
COPY . .

# Compile Solidity contracts
RUN solc --bin --abi --optimize --overwrite -o build/ *.sol

FROM node:18-alpine
WORKDIR /app

# Install web3 and other dependencies
RUN npm install -g web3 @truffle/hdwallet-provider

COPY --from=builder /app/build ./build
COPY package*.json ./
RUN npm install

COPY . .

EXPOSE 8080

CMD ["node", "deploy.js"]
