# ChainRice PHP Bridge
FROM nixos/nix:2.18-alpine AS nix-builder

# Install Nix packages
COPY stacks/tools/DEV/packages/flake.nix /tmp/flake.nix
COPY stacks/tools/DEV/packages/libs /tmp/libs

# Build PHP bridge using Nix
RUN nix-env -i -f /tmp/flake.nix -A packages.chainrice-php-bridge

# Final stage
FROM php:8.3-fpm-alpine

# Install runtime dependencies
RUN apk add --no-cache ca-certificates tzdata nginx

# Install PHP extensions
RUN docker-php-ext-install pdo pdo_mysql

# Create app user
RUN addgroup -g 1001 -S chainrice && \
    adduser -u 1001 -S chainrice -G chainrice

# Set working directory
WORKDIR /app

# Copy PHP bridge from Nix build
COPY --from=nix-builder /nix/store/*chainrice-php-bridge*/bin/chainrice-php-bridge /app/
COPY stacks/backend/PHP/ ./

# Install PHP dependencies
RUN composer install --no-dev --optimize-autoloader

# Copy nginx config
COPY nginx/nginx.conf /etc/nginx/nginx.conf

# Change ownership
RUN chown -R chainrice:chainrice /app

# Switch to non-root user
USER chainrice

# Expose port
EXPOSE 8086

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8086/health || exit 1

# Run the PHP bridge
CMD ["./chainrice-php-bridge"]