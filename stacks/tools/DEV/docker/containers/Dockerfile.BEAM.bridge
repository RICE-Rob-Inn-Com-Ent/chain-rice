# ChainRice BEAM Bridge
FROM nixos/nix:2.18-alpine AS nix-builder

# Install Nix packages
COPY stacks/tools/DEV/packages/flake.nix /tmp/flake.nix
COPY stacks/tools/DEV/packages/libs /tmp/libs

# Build BEAM bridge using Nix
RUN nix-env -i -f /tmp/flake.nix -A packages.chainrice-beam-bridge

# Final stage
FROM alpine:latest

# Install runtime dependencies
RUN apk add --no-cache ca-certificates tzdata openssl

# Create app user
RUN addgroup -g 1001 -S chainrice && \
    adduser -u 1001 -S chainrice -G chainrice

# Set working directory
WORKDIR /app

# Copy BEAM bridge from Nix build
COPY --from=nix-builder /nix/store/*chainrice-beam-bridge*/bin/chainrice-beam-bridge /app/
COPY stacks/backend/BEAM/ ./

# Change ownership
RUN chown -R chainrice:chainrice /app

# Switch to non-root user
USER chainrice

# Expose port
EXPOSE 8083

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8083/health || exit 1

# Run the BEAM bridge
CMD ["./chainrice-beam-bridge"]