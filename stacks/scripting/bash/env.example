# =============================================================================
# Chain Rice Scripts Environment Configuration
# =============================================================================
# This file contains environment variables used by the Chain Rice scripts
# collection. Copy this file to .env and modify the values according to your
# environment and needs.
#
# Usage: cp env.example .env
#        source .env before running scripts
# Or: export $(cat .env | xargs) to load all variables
# =============================================================================

# =============================================================================
# Project Configuration
# =============================================================================

# Project root directory
CHAIN_RICE_ROOT="/media/mrdinkelman/Dev/chain-rice"

# Scripts directory
CHAIN_RICE_SCRIPTS="$CHAIN_RICE_ROOT/examples/scripts"

# Project name and version
PROJECT_NAME="chain-rice"
PROJECT_VERSION="1.0.0"
PROJECT_DESCRIPTION="Chain Rice Development Environment"

# =============================================================================
# Build Configuration
# =============================================================================

# Build directories
BUILD_DIR="$CHAIN_RICE_ROOT/build"
LOG_DIR="$CHAIN_RICE_ROOT/logs"
TARGET_DIR="$CHAIN_RICE_ROOT/target"
CACHE_DIR="$CHAIN_RICE_ROOT/.cache"
PROFILE_DIR="$CHAIN_RICE_ROOT/profiles"
BACKUP_DIR="$CHAIN_RICE_ROOT/backups"

# Build settings
BUILD_TYPE="release"
PARALLEL_JOBS=4
ENABLE_PROFILE=false
ENABLE_DEBUG=false
VERBOSE_OUTPUT=false

# Build timeouts (in seconds)
BUILD_TIMEOUT=1800
TEST_TIMEOUT=600
INSTALL_TIMEOUT=300

# =============================================================================
# Service Configuration
# =============================================================================

# Service ports
RUST_API_PORT=8080
SCALA_API_PORT=8081
GO_SERVICE_PORT=8082
PYTHON_SERVICE_PORT=8083
NODE_SERVICE_PORT=8084
JAVA_SERVICE_PORT=8085

# Service directories
RUST_DIR="$CHAIN_RICE_ROOT/examples/rust"
SCALA_DIR="$CHAIN_RICE_ROOT/examples/scala"
GO_DIR="$CHAIN_RICE_ROOT/examples/go"
PYTHON_DIR="$CHAIN_RICE_ROOT/examples/python"
NODE_DIR="$CHAIN_RICE_ROOT/examples/node"
JAVA_DIR="$CHAIN_RICE_ROOT/examples/java"

# Service commands
RUST_COMMAND="cargo run"
SCALA_COMMAND="sbt run"
GO_COMMAND="go run main.go"
PYTHON_COMMAND="python main.py"
NODE_COMMAND="npm start"
JAVA_COMMAND="mvn spring-boot:run"

# Service timeouts (in seconds)
SERVICE_START_TIMEOUT=30
SERVICE_STOP_TIMEOUT=10
SERVICE_HEALTH_CHECK_TIMEOUT=5

# =============================================================================
# Development Environment
# =============================================================================

# Editor and tools
EDITOR="vim"
VISUAL="vim"
PAGER="less"
LESS="-R"

# Language settings
LANG="en_US.UTF-8"
LC_ALL="en_US.UTF-8"
LC_CTYPE="en_US.UTF-8"

# Development mode
NODE_ENV="development"
PYTHON_ENV="development"
RUST_ENV="development"

# =============================================================================
# Language-Specific Configuration
# =============================================================================

# Rust configuration
RUST_BACKTRACE=1
CARGO_TARGET_DIR="$TARGET_DIR"
CARGO_HOME="$HOME/.cargo"
RUSTUP_HOME="$HOME/.rustup"

# Go configuration
GOPATH="$HOME/go"
GOBIN="$HOME/go/bin"
GOCACHE="$CACHE_DIR/go"
GOMODCACHE="$HOME/go/pkg/mod"

# Java configuration
JAVA_HOME="/usr/lib/jvm/java-17-openjdk"
JAVA_OPTS="-Xmx2g -Xms1g"
MAVEN_OPTS="-Xmx2g -Xms1g"

# Scala configuration
SCALA_HOME="/usr/local/scala"
SBT_HOME="$HOME/.sbt"
SBT_OPTS="-Xmx2g -Xms1g"

# Python configuration
PYTHONPATH="$CHAIN_RICE_ROOT:$PYTHONPATH"
PYTHONUNBUFFERED=1
PIP_CACHE_DIR="$CACHE_DIR/pip"

# Node.js configuration
NPM_CONFIG_CACHE="$CACHE_DIR/npm"
NPM_CONFIG_PREFIX="$HOME/.npm-global"
YARN_CACHE_FOLDER="$CACHE_DIR/yarn"

# =============================================================================
# Docker Configuration
# =============================================================================

# Docker settings
DOCKER_HOST="unix:///var/run/docker.sock"
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1
COMPOSE_PROJECT_NAME="chain-rice"

# Docker registry
DOCKER_REGISTRY="docker.io"
DOCKER_NAMESPACE="chain-rice"

# Container settings
CONTAINER_MEMORY_LIMIT="2g"
CONTAINER_CPU_LIMIT="2"
CONTAINER_RESTART_POLICY="unless-stopped"

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="chain_rice"
DB_USER="chain_rice"
DB_PASSWORD="password"
DB_URL="postgresql://$DB_USER:$DB_PASSWORD@$DB_HOST:$DB_PORT/$DB_NAME"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL="redis://$REDIS_HOST:$REDIS_PORT"

# MongoDB
MONGO_HOST="localhost"
MONGO_PORT=27017
MONGO_DB="chain_rice"
MONGO_URL="mongodb://$MONGO_HOST:$MONGO_PORT/$MONGO_DB"

# =============================================================================
# Logging Configuration
# =============================================================================

# Log levels
LOG_LEVEL="INFO"
LOG_FORMAT="json"
LOG_FILE="$LOG_DIR/chain-rice.log"
LOG_MAX_SIZE="100MB"
LOG_MAX_FILES=10

# Log rotation
LOG_ROTATE_SIZE="100M"
LOG_ROTATE_COUNT=10
LOG_ROTATE_COMPRESS=true

# =============================================================================
# Monitoring Configuration
# =============================================================================

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH="/metrics"

# Health checks
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PORT=8086
HEALTH_CHECK_PATH="/health"

# Monitoring intervals (in seconds)
MONITORING_INTERVAL=30
HEALTH_CHECK_INTERVAL=10
METRICS_COLLECTION_INTERVAL=60

# =============================================================================
# Security Configuration
# =============================================================================

# SSL/TLS
SSL_ENABLED=false
SSL_CERT_PATH=""
SSL_KEY_PATH=""
SSL_CA_PATH=""

# Authentication
AUTH_ENABLED=false
AUTH_SECRET=""
JWT_SECRET=""
SESSION_SECRET=""

# CORS
CORS_ENABLED=true
CORS_ORIGINS="*"
CORS_METHODS="GET,POST,PUT,DELETE,OPTIONS"
CORS_HEADERS="Content-Type,Authorization"

# =============================================================================
# Network Configuration
# =============================================================================

# Network settings
NETWORK_TIMEOUT=30
CONNECTION_TIMEOUT=10
READ_TIMEOUT=30
WRITE_TIMEOUT=30

# Proxy settings
HTTP_PROXY=""
HTTPS_PROXY=""
NO_PROXY="localhost,127.0.0.1"

# =============================================================================
# Performance Configuration
# =============================================================================

# CPU settings
MAX_CPU_CORES=8
CPU_AFFINITY=""

# Memory settings
MAX_MEMORY="4g"
MEMORY_PRESSURE_THRESHOLD=80

# I/O settings
MAX_IO_THREADS=4
IO_BUFFER_SIZE="64k"

# =============================================================================
# Backup Configuration
# =============================================================================

# Backup settings
BACKUP_ENABLED=true
BACKUP_INTERVAL="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION=true

# Backup locations
BACKUP_LOCAL_PATH="$BACKUP_DIR"
BACKUP_REMOTE_PATH=""
BACKUP_S3_BUCKET=""

# =============================================================================
# Development Tools Configuration
# =============================================================================

# Git configuration
GIT_USER_NAME="Chain Rice Developer"
GIT_USER_EMAIL="developer@chain-rice.com"
GIT_DEFAULT_BRANCH="main"

# IDE configuration
VSCODE_SETTINGS_PATH="$HOME/.vscode/settings.json"
INTELLIJ_SETTINGS_PATH="$HOME/.IntelliJIdea/settings"

# Terminal configuration
TERM="xterm-256color"
COLORTERM="truecolor"

# =============================================================================
# Testing Configuration
# =============================================================================

# Test settings
TEST_ENABLED=true
TEST_PARALLEL=true
TEST_COVERAGE=true
TEST_TIMEOUT=300

# Test directories
TEST_DIR="$CHAIN_RICE_ROOT/tests"
COVERAGE_DIR="$CHAIN_RICE_ROOT/coverage"

# Test databases
TEST_DB_HOST="localhost"
TEST_DB_PORT=5433
TEST_DB_NAME="chain_rice_test"
TEST_DB_USER="chain_rice_test"
TEST_DB_PASSWORD="test_password"

# =============================================================================
# CI/CD Configuration
# =============================================================================

# CI settings
CI_ENABLED=false
CI_PROVIDER="github"
CI_BRANCH="main"
CI_TRIGGER="push"

# Deployment settings
DEPLOY_ENABLED=false
DEPLOY_ENVIRONMENT="staging"
DEPLOY_STRATEGY="rolling"
DEPLOY_TIMEOUT=600

# =============================================================================
# Feature Flags
# =============================================================================

# Feature toggles
FEATURE_RUST_API=true
FEATURE_SCALA_API=true
FEATURE_GO_SERVICE=true
FEATURE_PYTHON_SERVICE=true
FEATURE_NODE_SERVICE=true
FEATURE_JAVA_SERVICE=true

FEATURE_DOCKER=true
FEATURE_DATABASE=true
FEATURE_REDIS=true
FEATURE_MONITORING=true
FEATURE_LOGGING=true
FEATURE_BACKUP=true

# =============================================================================
# Debug Configuration
# =============================================================================

# Debug settings
DEBUG_ENABLED=false
DEBUG_LEVEL="INFO"
DEBUG_PORT=5678

# Profiling
PROFILING_ENABLED=false
PROFILING_OUTPUT="$PROFILE_DIR"
PROFILING_DURATION=60

# Tracing
TRACING_ENABLED=false
TRACING_SAMPLING_RATE=0.1
TRACING_ENDPOINT=""

# =============================================================================
# Custom Configuration
# =============================================================================

# Custom variables (add your own here)
CUSTOM_VAR1=""
CUSTOM_VAR2=""
CUSTOM_VAR3=""

# Environment-specific overrides
if [[ "$ENVIRONMENT" == "production" ]]; then
    BUILD_TYPE="release"
    LOG_LEVEL="WARN"
    DEBUG_ENABLED=false
    PROFILING_ENABLED=false
elif [[ "$ENVIRONMENT" == "staging" ]]; then
    BUILD_TYPE="release"
    LOG_LEVEL="INFO"
    DEBUG_ENABLED=false
    PROFILING_ENABLED=true
elif [[ "$ENVIRONMENT" == "development" ]]; then
    BUILD_TYPE="debug"
    LOG_LEVEL="DEBUG"
    DEBUG_ENABLED=true
    PROFILING_ENABLED=true
fi

# =============================================================================
# Export Variables
# =============================================================================

# Export all variables for use in scripts
export CHAIN_RICE_ROOT
export CHAIN_RICE_SCRIPTS
export PROJECT_NAME
export PROJECT_VERSION
export BUILD_DIR
export LOG_DIR
export TARGET_DIR
export CACHE_DIR
export PROFILE_DIR
export BACKUP_DIR
export BUILD_TYPE
