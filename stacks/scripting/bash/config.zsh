  pyenv
  nodenv
  nvm
  nodeenv
  node_version
  go_version
  rust_version
  java_version
  scala_version
  time
)

# Directory settings
POWERLEVEL9K_SHORTEN_STRATEGY=truncate_to_last
POWERLEVEL9K_SHORTEN_DELIMITER=
POWERLEVEL9K_DIR_FOREGROUND=39
POWERLEVEL9K_DIR_BACKGROUND=236

# VCS settings
POWERLEVEL9K_VCS_CLEAN_FOREGROUND=76
POWERLEVEL9K_VCS_CLEAN_BACKGROUND=236
POWERLEVEL9K_VCS_UNTRACKED_FOREGROUND=76
POWERLEVEL9K_VCS_UNTRACKED_BACKGROUND=236
POWERLEVEL9K_VCS_MODIFIED_FOREGROUND=196
POWERLEVEL9K_VCS_MODIFIED_BACKGROUND=236

# Status settings
POWERLEVEL9K_STATUS_OK_FOREGROUND=70
POWERLEVEL9K_STATUS_OK_BACKGROUND=236
POWERLEVEL9K_STATUS_ERROR_FOREGROUND=160
POWERLEVEL9K_STATUS_ERROR_BACKGROUND=236

# Time settings
POWERLEVEL9K_TIME_FOREGROUND=66
POWERLEVEL9K_TIME_BACKGROUND=236
POWERLEVEL9K_TIME_FORMAT='%D{%H:%M:%S}'

# Version settings
POWERLEVEL9K_NODE_VERSION_FOREGROUND=70
POWERLEVEL9K_NODE_VERSION_BACKGROUND=236
POWERLEVEL9K_GO_VERSION_FOREGROUND=70
POWERLEVEL9K_GO_VERSION_BACKGROUND=236
