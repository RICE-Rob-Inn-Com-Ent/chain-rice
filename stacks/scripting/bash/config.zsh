#!/usr/bin/env zsh
# =============================================================================
# Chain Rice Zsh Configuration Script
# =============================================================================
# This script provides comprehensive Zsh configuration for the Chain Rice
# development environment, including themes, plugins, and productivity features.
#
# Usage: source config.zsh
# Or add to your .zshrc: source /path/to/config.zsh
# =============================================================================

# =============================================================================
# Configuration Variables
# =============================================================================

# Colors
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly PURPLE='\033[0;35m'
readonly CYAN='\033[0;36m'
readonly NC='\033[0m'

# Project paths
readonly CHAIN_RICE_ROOT="/media/mrdinkelman/Dev/chain-rice"
readonly CHAIN_RICE_SCRIPTS="$CHAIN_RICE_ROOT/examples/scripts"

# Plugin directories
readonly ZSH_PLUGINS_DIR="$HOME/.zsh-plugins"
readonly ZSH_THEMES_DIR="$HOME/.zsh-themes"

# =============================================================================
# Utility Functions
# =============================================================================

log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

log_debug() {
    [[ "$DEBUG" == "true" ]] && echo -e "${BLUE}[DEBUG]${NC} $1"
}

# =============================================================================
# Directory Creation and Setup
# =============================================================================

setup_directories() {
    local dirs=("$ZSH_PLUGINS_DIR" "$ZSH_THEMES_DIR" "$HOME/.zsh-cache")
    
    for dir in "${dirs[@]}"; do
        if [[ ! -d "$dir" ]]; then
            mkdir -p "$dir"
            log_debug "Created directory: $dir"
        fi
    done
}

# =============================================================================
# Plugin Management
# =============================================================================

install_plugin() {
    local plugin_name="$1"
    local plugin_url="$2"
    local plugin_dir="$ZSH_PLUGINS_DIR/$plugin_name"
    
    if [[ ! -d "$plugin_dir" ]]; then
        log_info "Installing plugin: $plugin_name"
        git clone "$plugin_url" "$plugin_dir"
    else
        log_debug "Plugin $plugin_name already installed"
    fi
}

load_plugin() {
    local plugin_name="$1"
    local plugin_file="$2"
    local plugin_dir="$ZSH_PLUGINS_DIR/$plugin_name"
    
    if [[ -f "$plugin_dir/$plugin_file" ]]; then
        source "$plugin_dir/$plugin_file"
        log_debug "Loaded plugin: $plugin_name"
    else
        log_warn "Plugin file not found: $plugin_dir/$plugin_file"
    fi
}

# =============================================================================
# Essential Plugins Installation
# =============================================================================

install_essential_plugins() {
    log_info "Installing essential Zsh plugins..."
    
    # Oh My Zsh (if not already installed)
    if [[ ! -d "$HOME/.oh-my-zsh" ]]; then
        log_info "Installing Oh My Zsh..."
        sh -c "$(curl -fsSL https://raw.github.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
    fi
    
    # Zsh Autosuggestions
    install_plugin "zsh-autosuggestions" "https://github.com/zsh-users/zsh-autosuggestions.git"
    
    # Zsh Syntax Highlighting
    install_plugin "zsh-syntax-highlighting" "https://github.com/zsh-users/zsh-syntax-highlighting.git"
    
    # Zsh Completions
    install_plugin "zsh-completions" "https://github.com/zsh-users/zsh-completions.git"
    
    # Powerlevel10k Theme
    install_plugin "powerlevel10k" "https://github.com/romkatv/powerlevel10k.git"
    
    # FZF
    if ! command -v fzf >/dev/null 2>&1; then
        log_info "Installing FZF..."
        git clone --depth 1 https://github.com/junegunn/fzf.git ~/.fzf
        ~/.fzf/install --key-bindings --completion --no-update-rc
    fi
    
    log_info "Essential plugins installed successfully"
}

# =============================================================================
# Theme Configuration
# =============================================================================

setup_powerlevel10k() {
    log_info "Setting up Powerlevel10k theme..."
    
    # Create Powerlevel10k configuration
    cat > "$HOME/.p10k.zsh" << 'EOF'
