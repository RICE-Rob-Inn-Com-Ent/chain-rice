# Copy to .env and fill in. === Application ===
APP_TITLE=rice-bot
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development

# === LLM (required for chat/agents) ===
LITELLM_API_KEY=sk-your-api-key-here
LITELLM_MODEL=gpt-4o-mini
LITELLM_TEMPERATURE=0.7
LITELLM_MAX_TOKENS=2000
LITELLM_TIMEOUT=30

# === Feature Flags ===
ENABLE_AGENTS=false
ENABLE_QUANTUM=false
ENABLE_DATA=true
ENABLE_GPU=false
ENABLE_SECURITY_SCANS=false

# === DuckDB ===
DUCKDB_PATH=:memory:
DUCKDB_MEMORY_LIMIT=2GB
DUCKDB_THREADS=4

# === Qdrant (extra: model) ===
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=documents
QDRANT_VECTOR_SIZE=384

# === GPU (extra: job) ===
CUDA_VISIBLE_DEVICES=0,1
CUDA_MEMORY_FRACTION=0.8
TORCH_HOME=

# === Logging ===
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=

# === Security ===
BANDIT_SEVERITY_THRESHOLD=MEDIUM
AUDIT_FAIL_ON_CVE=true
GUARDRAILS_PII_SCRUB=true

# === CORS ===
CORS_ALLOW_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

AGENT_RECURSION_LIMIT=10
