{
  "name": "@rice-mono/ui-kit",
  "version": "1.1.0",
  "description": "Rice UI Kit - Reusable React components library with AI model demos and benchmarks",
  "main": "./lib/index.ts",
  "types": "./lib/index.ts",
  "exports": {
    ".": "./lib/index.ts",
    "./lib": "./lib/index.ts",
    "./models": "./models/index.ts",
    "./benchmark": "./benchmark/index.ts",
    "./styles": "./index.css",
    "./tailwind": "./tailwind.config.ts",
    "./postcss": "./postcss.config.ts"
  },
  "files": [
    "lib/",
    "models/",
    "benchmark/",
    "src/",
    "*.ts",
    "*.tsx",
    "*.css",
    "*.json",
    "tailwind.config.ts",
    "postcss.config.ts"
  ],
  "scripts": {
    "dev": "vite --port 3001 --host 0.0.0.0",
    "dev:debug": "vite --port 3001 --host 0.0.0.0 --debug",
    "build": "vite build",
    "build:lib": "tsc --project tsconfig.lib.json && cp package.json dist/ && cp README_NPM.md dist/README.md",
    "preview": "vite preview --port 3001",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf node_modules dist",
    "prepublishOnly": "yarn build:lib"
  },
  "dependencies": {
    "@iconify/react": "6.0.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.16",
    "chart.js": "^4.4.1",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.0",
    "three": "^0.157.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.0.0",
    "cssnano": "^6.0.3",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.0.0",
    "husky": "^9.0.7",
    "jsdom": "^22.0.0",
    "lint-staged": "^15.2.2",
    "postcss-preset-env": "^9.3.0",
    "prettier": "^3.2.4",
    "stylelint": "^15.10.0",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-standard": "^34.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vitest": "^1.2.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "nextjs",
    "react",
    "components",
    "seo",
    "tailwindcss",
    "typescript",
    "rice-mono",
    "ai",
    "ui-kit"
  ],
  "author": "Rice-Mono Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rice-mono/ui-kit"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
