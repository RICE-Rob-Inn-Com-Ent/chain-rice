# ============================================
# Dockerfile.dual - Vite (3001) + Next.js (3002)
# ============================================

FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat python3 make g++
WORKDIR /app

# ============================================
# Stage: Dependencies
# ============================================
FROM base AS deps
COPY package.json yarn.lock ./
COPY .frontend/web/package.json ./.frontend/web/
COPY .project/web/package.json ./.project/web/
RUN yarn install --frozen-lockfile || yarn install

# ============================================
# Stage: Development (Dual Server)
# ============================================
FROM base AS development
WORKDIR /app

# Copy dependencies
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/.frontend/web/node_modules ./.frontend/web/node_modules
COPY --from=deps /app/.project/web/node_modules ./.project/web/node_modules

# Copy source code
COPY . .

# Create entrypoint script in /usr/local/bin (not affected by volume mounts)
RUN cat > /usr/local/bin/start-dual.sh << 'EOF'
#!/bin/sh
set -e

echo "🚀 Starting Dual Frontend Server..."
echo "📦 Vite UI Kit   → http://localhost:3001"
echo "⚡ Next.js App   → http://localhost:3002"

# Start Vite dev server in background
cd /app/.frontend/web
yarn dev --host 0.0.0.0 --port ${VITE_PORT:-3001} &
VITE_PID=$!

# Start Next.js dev server in foreground
cd /app/.project/web
yarn dev --port ${NEXT_PORT:-3002}

# If Next.js exits, kill Vite too
kill $VITE_PID 2>/dev/null || true
EOF

RUN chmod +x /usr/local/bin/start-dual.sh

EXPOSE 3001 3002

CMD ["/bin/sh", "/usr/local/bin/start-dual.sh"]

