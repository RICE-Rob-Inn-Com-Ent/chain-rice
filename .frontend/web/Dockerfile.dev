# Development Dockerfile for Egyptian AI Dashboard
# Runs Vite dev server on port 3001 with hot reload

FROM node:20-alpine

# Install dependencies for better file watching
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    git

WORKDIR /app

# Copy package files
COPY package.json yarn.lock* package-lock.json* ./

# Install dependencies
RUN npm install -g yarn && yarn install

# Copy source code (will be overridden by volume mount for hot reload)
COPY . .

# Expose Vite dev server port
EXPOSE 3001

# Environment variables for Vite
ENV VITE_HOST=0.0.0.0
ENV VITE_PORT=3001
ENV CHOKIDAR_USEPOLLING=true
ENV WATCHPACK_POLLING=true

# Start Vite dev server
CMD ["yarn", "dev"]

