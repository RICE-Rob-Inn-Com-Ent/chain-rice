FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package.json yarn.lock* package-lock.json* pnpm-lock.yaml* ./

# Install dependencies
RUN npm install

# Copy source
COPY . .

# Expose port 3002
EXPOSE 3002

# Enable hot reload
ENV CHOKIDAR_USEPOLLING=true

# Start dev server
CMD ["npm", "run", "dev"]

