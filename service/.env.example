# ==============================================================================
# 🧩 Project-Specific Environment Template
# ------------------------------------------------------------------------------
# HOW TO USE THIS TEMPLATE
# - Copy this file to each project folder as `.env.project`
# - Example: `.project/code_rice/.env.project`
# - Each project has its own isolated configuration
# - DevContainer reads from root `.env` (global) + project `.env.project` (specific)
# ==============================================================================

###############################################################################
# 🏷️ Project
###############################################################################
PROJECT_NAME=
PROJECT_SLUG=

###############################################################################
# 🗄️ Database
###############################################################################
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_URL=
POSTGRES_SSLMODE=disable
DATABASE_URL=
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DB=
MONGODB_DATABASE=
MONGODB_URL=
MONGODB_AUTH_SOURCE=admin
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=
REDIS_POOL_SIZE=10

# Cassandra (per-project overrides, optional)
CASSANDRA_URL=
CASSANDRA_HOSTS=
CASSANDRA_PORT=
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=
CASSANDRA_KEYSPACE=
CASSANDRA_CONSISTENCY=
CASSANDRA_NUM_CONNECTIONS=
CASSANDRA_TIMEOUT=
CASSANDRA_CONNECT_TIMEOUT=
CASSANDRA_SSL_ENABLED=

# Data Warehouse / Store (per-project overrides, optional)
DATAWAREHOUSE_PROVIDER=
GOOGLE_APPLICATIONS_CREDENTIALS_JSON=
REDSHIFT_PASSWORD=
SYNAPSE_PASSWORD=

###############################################################################
# 🏗️ IaC
###############################################################################
VAULT_TOKEN=
# Note: CONSUL_ADDR is set globally in .envrc
TF_VAR_project_name=
TF_VAR_aws_region=
TF_VAR_azure_region=
TF_VAR_gcp_region=

###############################################################################
# 🌐 GraphQL
###############################################################################
GRAPHQL_SERVICE_NAME=
AUTH_SERVICE_URL=http://localhost:4001

###############################################################################
# 🔒 Security & Authentication (optional, per-project)
###############################################################################
JWT_SECRET_KEY=

###############################################################################
# ☸️ Kubernetes
###############################################################################
K8S_REGISTRY=
K8S_NAMESPACE=
PROJECT_DOMAIN=

###############################################################################
# ☁️ Cloud
