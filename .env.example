# ====================================================================
# 🌐 GLOBAL CONFIGURATION
# ====================================================================

APP_ENV=development                # Environment type: development / staging / production
PROJECT_NAME=QuantumResistantChain # Project name
CHAIN_ID=dev-qrchain-1             # Unique Blockchain chain ID

# ====================================================================
# 🚀 BLOCKCHAIN (COSMOS SDK / GOLANG)
# ====================================================================

COSMOS_NODE_RPC=http://localhost:26657       # RPC endpoint for Cosmos node
COSMOS_NODE_GRPC=http://localhost:9090        # gRPC endpoint for Cosmos node
COSMOS_NODE_P2P_PORT=26656                    # P2P port for validator/node communication

BLOCKCHAIN_MONIKER=localdev                   # Node moniker (name)
BLOCKCHAIN_KEYRING_BACKEND=test               # Keyring backend: test / file / memory

GENESIS_FILE_PATH=./config/genesis.json       # Path to genesis file
CONFIG_TOML_PATH=./config/config.toml         # Path to config.toml

BLOCK_GAS_LIMIT=10000000                      # Maximum gas per block
BLOCK_TIME_INTERVAL=5                         # Block production interval in seconds

# ====================================================================
# 🔐 CRYPTOGRAPHY / POST-QUANTUM PLACEHOLDER (FOR DEMO PURPOSES ONLY)
# ====================================================================

PRIVATE_KEY_PATH=./secrets/dev-node.key       # Private node key (DO NOT PUSH TO GIT!)
PUBLIC_KEY_PATH=./secrets/dev-node.pub        # Public node key

# In real production setup, replace with post-quantum cryptographic keys (NTRU, Kyber, etc.)
USE_POST_QUANTUM_CRYPTO=false

# ====================================================================
# 🎯 SMART CONTRACTS (CosmWasm / Rust)
# ====================================================================

WASM_CONTRACTS_PATH=./contracts/compiled      # Folder for compiled .wasm smart contracts
WASM_UPLOAD_ACCOUNT=dev_account               # Account name used for contract deployment

# Placeholder for CosmWasm CLI key (NEVER store real private keys in .env in production)
COSMWASM_PRIVATE_KEY=demo_cosmwasm_private_key

# ====================================================================
# 🧠 BACKEND API (FastAPI / Python)
# ====================================================================

API_HOST=0.0.0.0                   # API host (0.0.0.0 allows external connections)
API_PORT=8000                      # API port
API_DEBUG=true                     # Debug mode (disable in production)

DATABASE_URL=postgresql://dev_user:dev_pass@localhost:5432/dev_db   # PostgreSQL connection

JWT_SECRET_KEY=super_secret_dev_key          # JWT Secret for token generation (do not use in prod)
JWT_ALGORITHM=HS256                         # JWT algorithm
ACCESS_TOKEN_EXPIRE_MINUTES=60              # Access token expiration time

# ====================================================================
# 🔗 FRONTEND (React / TypeScript / Vite)
# ====================================================================

VITE_API_URL=http://localhost:8000          # Backend API URL
VITE_CHAIN_RPC=http://localhost:26657       # Blockchain RPC for frontend
VITE_CHAIN_ID=dev-qrchain-1                  # Blockchain Chain ID (frontend)

# ====================================================================
# 📡 WEBSOCKETS / PUBSUB / REALTIME
# ====================================================================

WS_PUBLIC_URL=ws://localhost:8000/ws/public   # Public websocket endpoint
WS_PRIVATE_URL=ws://localhost:8000/ws/private # Private websocket endpoint

# ====================================================================
# 🧪 DEV TOOLS / DEBUGGING / METRICS
# ====================================================================

ENABLE_PROMETHEUS_METRICS=true               # Enable Prometheus metrics exporter
PROMETHEUS_PORT=9000                         # Prometheus exporter port

ENABLE_OPENTELEMETRY=false                   # OpenTelemetry tracing
OTEL_EXPORTER=stdout                         # Export traces to stdout (default for dev)

# ====================================================================
# 🚧 SECURITY / ZERO TRUST PLACEHOLDER (DO NOT USE IN PRODUCTION)
# ====================================================================

DISABLE_CSRF=true                # Disable CSRF protection (FOR DEV ONLY!)
ALLOWED_ORIGINS=*                # CORS settings (allow all origins in dev)
RATE_LIMIT=1000                  # Requests per minute (basic rate limiting)

# ====================================================================
# 🛑 IMPORTANT NOTICE: DO NOT COMMIT REAL .env FILES
# ====================================================================
# This file is an example template (.env.example) for educational and development purposes.
#
# DO NOT commit your actual `.env` files to public repositories.
#
# Recommended production setup:
# - Use Hashicorp Vault, AWS Secrets Manager, or Kubernetes Secrets for real secrets.
# - Use Hardware Security Modules (HSM) for private keys.
#
# ====================================================================
