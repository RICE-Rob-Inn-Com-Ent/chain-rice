{
  "name": "@rice/node",
  "version": "1.0.0",
  "private": true,
  "description": "Node runtime for Rice",
  "type": "module",
  "workspaces": [
    "../../.project/*/web",
    "../bot",
    "../contract",
    "../service",
    "../core",
    "../infra"
  ],
  "engines": {
    "bun": ">=1.1.38"
  },
  "scripts": {
    "//_api": "================ API Gateway ===================",
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "//_orchestration": "================ Polyglot Orchestration ===================",
    "dev:all": "concurrently \"bun dev\" \"bun python:dev\" \"bun service:dev\" \"bun core:dev\"",
    "//_python": "================ Python Bot (AI/ML) ===================",
    "python:dev": "cd ../bot && uv run fastapi dev main.py",
    "python:install": "cd ../bot && uv sync",
    "python:lint": "cd ../bot && ruff check . && ruff format .",
    "python:test": "cd ../bot && pytest",
    "//_rust": "================ Rust Contracts ===================",
    "rust:check": "cargo check --workspace --manifest-path ../store/Cargo.toml",
    "rust:build": "cargo build --workspace --release --manifest-path ../store/Cargo.toml",
    "rust:test": "cargo test --workspace --manifest-path ../store/Cargo.toml",
    "rust:wasm": "cargo build --release --target wasm32-unknown-unknown --manifest-path ../store/Cargo.toml",
    "rust:optimize": "cd ../contract && wasm-opt -Oz -o optimized.wasm target/wasm32-unknown-unknown/release/*.wasm",
    "rust:lint": "cargo fmt --all --manifest-path ../store/Cargo.toml -- --check && cargo clippy --workspace --manifest-path ../store/Cargo.toml",
    "//_go": "================ Go Services ===================",
    "service:dev": "cd ../service && air",
    "service:build": "cd ../service && go build -o bin/service ./cmd/service",
    "service:test": "cd ../service && go test -v -race ./...",
    "service:proto": "cd ../service && buf generate",
    "proto": "buf generate",
    "service:lint": "cd ../service && golangci-lint run",
    "//_elixir": "================ Elixir Core ===================",
    "core:dev": "cd ../core && iex -S mix phx.server",
    "core:setup": "cd ../core && mix setup",
    "core:test": "cd ../core && mix test",
    "core:release": "cd ../core && mix release",
    "//_circuits": "================ ZK Circuits ===================",
    "circuit:circom:compile": "bun run scripts/compile-circom.ts",
    "circuit:circom:setup": "bun run scripts/setup-circom.ts",
    "circuit:gnark:compile": "bun run scripts/compile-gnark.ts",
    "circuit:test": "bun test circuits/**/*.test.ts",
    "circuit:benchmark": "bun run scripts/benchmark-proofs.ts",
    "//_evm": "================ EVM Contracts (Hardhat) ===================",
    "contract:compile": "hardhat compile",
    "contract:test": "hardhat test",
    "contract:deploy": "hardhat run scripts/deploy.ts --network",
    "contract:node": "hardhat node",
    "//_cosmwasm": "================ CosmWasm Contracts ===================",
    "cosmwasm:optimize": "docker run --rm -v $(pwd)/../contract:/code cosmwasm/optimizer:0.16.0",
    "cosmwasm:deploy": "bun run scripts/deploy-cosmwasm.ts",
    "//_infra": "================ Infrastructure ===================",
    "infra:plan": "cd ../infra && terraform plan",
    "infra:apply": "cd ../infra && terraform apply",
    "infra:k8s": "kubectl apply -f ../infra/k8s/",
    "//_quality": "================ Testing & Quality ===================",
    "test": "bun test",
    "test:e2e": "bun test e2e/**/*.test.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "type-check": "tsc --noEmit",
    "//_monorepo": "================ Monorepo Tools ===================",
    "clean": "rm -rf node_modules dist .turbo && bun run clean:all",
    "clean:all": "bun run python:clean && cargo clean --manifest-path ../store/Cargo.toml",
    "format": "biome format --write .",
    "//_deploy": "================ Deployment ===================",
    "docker:build": "docker buildx build --platform linux/amd64,linux/arm64 -t rice/gateway .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "//_framework": "================ API Gateway Framework ===================",
    "elysia": "^1.2.15",
    "@elysiajs/cors": "^1.2.1",
    "@elysiajs/swagger": "^1.2.1",
    "@elysiajs/static": "^1.2.0",
    "//_grpc_client": "================ gRPC Client (Go services) ===================",
    "@connectrpc/connect": "^2.3.0",
    "@connectrpc/connect-node": "^2.3.0",
    "@bufbuild/protobuf": "^2.2.2",
    "//_validation": "================ Validation & Schema ===================",
    "valibot": "^0.42.1",
    "zod": "^3.23.8",
    "//_blockchain": "================ Blockchain (Deploy Only) ===================",
    "@cosmjs/cosmwasm-stargate": "^0.32.4",
    "@cosmjs/proto-signing": "^0.32.4",
    "@cosmjs/stargate": "^0.32.4",
    "ethers": "^6.13.4",
    "viem": "^2.21.54",
    "//_zk": "================ ZK Proofs (Circuit Compilation) ===================",
    "snarkjs": "^0.7.5",
    "circomlibjs": "^0.1.7",
    "//_utils": "================ Utils ===================",
    "date-fns": "^4.1.0",
    "nanoid": "^5.0.9"
  },
  "devDependencies": {
    "//_build": "================ Build Tools ===================",
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.7.2",
    "bun-types": "^1.1.38",
    "//_testing": "================ Testing ===================",
    "@happy-dom/global-registrator": "^15.11.7",
    "//_contracts": "================ Smart Contracts ===================",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-viem": "^2.0.5",
    "hardhat": "^2.22.18",
    "//_monorepo": "================ Monorepo ===================",
    "turbo": "^2.3.3",
    "concurrently": "^9.1.0",
    "//_codegen": "================ Code Generation ===================",
    "@bufbuild/protoc-gen-es": "^2.2.2",
    "@connectrpc/protoc-gen-connect-es": "^2.3.0",
    "//_deploy": "================ Deployment ===================",
    "dotenv": "^16.4.7",
    "@types/node": "^22.10.2"
  },
  "trustedDependencies": [
    "esbuild",
    "@biomejs/biome",
    "turbo"
  ]
}
