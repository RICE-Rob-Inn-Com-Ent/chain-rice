# MASON-generated Buck2 manifest — do not edit by hand.
# Source: infra/build/cue/frontend.cue — watches frontend/rule
# Rebuild: buck2 build '//frontend/rule:check'

genrule(
    name = "check",
    srcs = glob(["pubspec.yaml", "../pubspec.yaml", "lib/**/*.dart"]),
    out = "check.stamp",
    cmd = """
set -euo pipefail
REPO=$(git rev-parse --show-toplevel)
export PATH="$REPO/.pixi/envs/default/bin:$HOME/.pub-cache/bin:/usr/bin:$PATH"
cd "$REPO/frontend"
dart pub get
cd "$REPO/frontend/rule"
dart run build_runner build --delete-conflicting-outputs
dart analyze --fatal-warnings lib
touch "$OUT"
""",
    visibility = ["PUBLIC"],
)

