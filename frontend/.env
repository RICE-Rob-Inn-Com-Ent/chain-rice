# path: frontend/.env

### Shared
# REPO_ROOT=

### Build / artifacts
# CARGO_TARGET_DIR=
# CLERK_ARTIFACT_ROOT=

### Native bridges
# CLERK_CALC_LIB=
# CLERK_CALC_USE_BINARY=0
# CLERK_SECURITY_LIB_DIR=

### Tooling / bench
# CLERK_BENCH_BIN=
# CLERK_LSP_PERF=
# CLERK_BENCH_RUN_ZIG=0
# CLERK_USE_CALC_FFI=0

### Policy engine
# CLERK_POLICY_PARALLEL=
# CLERK_POLICY_AUDIT_LOG=
# CLERK_POLICY_AUDIT_SUBJECT=
# CLERK_POLICY_BLOCK_HEIGHT=
# CLERK_MASON_XML_NAMESPACE=
