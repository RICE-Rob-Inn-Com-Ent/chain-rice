# MASON-generated Buck2 manifest — do not edit by hand.
# Source: infra/build/cue/frontend.cue — watches frontend/content
# Rebuild: buck2 build '//frontend/content:check'

genrule(
    name = "check",
    srcs = glob(["pubspec.yaml", "../pubspec.yaml", "lib/**/*.dart"]),
    out = "check.stamp",
    cmd = """
set -euo pipefail
REPO=$(git rev-parse --show-toplevel)
export PATH="$REPO/.pixi/envs/default/bin:$HOME/.pub-cache/bin:/usr/bin:$PATH"
cd "$REPO/frontend"
dart pub get
cd "$REPO/frontend/content"
dart analyze --fatal-warnings lib
touch "$OUT"
""",
    visibility = ["PUBLIC"],
)

