{
  "name": "@rice/browser",
  "version": "1.0.0",
  "private": true,
  "description": "BARD — browser interfaces for rice OS",
  "type": "module",
  "engines": {
    "bun": ">=1.1.38"
  },
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "proto": "buf generate",
    "inject-rice-todos": "cd ../.. && python3 scripts/inject_rice_todos.py --root frontend/browser"
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-form": "^1.0.0",
    "zustand": "^5.0.0",
    "motion": "^11.0.0",
    "@react-three/fiber": "^8.0.0",
    "@react-three/drei": "^9.0.0",
    "tone": "^15.0.0",
    "@radix-ui/react-dialog": "^1.0.0",
    "@radix-ui/react-dropdown-menu": "^2.0.0",
    "@radix-ui/react-tooltip": "^1.0.0",
    "@radix-ui/react-tabs": "^1.0.0",
    "@radix-ui/react-slot": "^1.0.0",
    "tailwindcss": "^4.0.0",
    "next-intl": "^4.0.0",
    "posthog-js": "^1.0.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-web": "^2.1.1",
    "@bufbuild/protobuf": "^2.2.2",
    "zod": "^3.23.0",
    "phoenix": "^1.7.14",
    "recharts": "^2.15.0",
    "lucide-react": "^0.468.0",
    "sonner": "^1.7.0",
    "three": "^0.170.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.5.0",
    "react-day-picker": "^9.4.0",
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "typescript": "^5.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^22.0.0",
    "bun-types": "^1.1.38",
    "vitest": "^3.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "jsdom": "^26.0.0",
    "@testing-library/react": "^16.0.0",
    "playwright": "^1.50.0",
    "@playwright/test": "^1.50.0",
    "@bufbuild/protoc-gen-es": "^2.2.2",
    "@connectrpc/protoc-gen-connect-es": "^1.7.0",
    "@tailwindcss/postcss": "^4.0.0"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "esbuild"
  ]
