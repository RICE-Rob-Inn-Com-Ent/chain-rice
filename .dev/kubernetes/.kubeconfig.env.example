# Rice-Mono Kubeconfig Environment Variables
# Copy this file to .kubeconfig.env and fill in your actual values
# WARNING: .kubeconfig.env should NOT be committed to version control

# ============================================================================
# General Configuration
# ============================================================================
KUBECONFIG_DIR="/home/mrDinkelman/rice-mono/.dev/kubernetes"

# ============================================================================
# Cluster Endpoints
# ============================================================================
# Development cluster
DEV_CLUSTER_ENDPOINT="https://dev.rice-mono.local:6443"

# Staging cluster
STAGING_CLUSTER_ENDPOINT="https://staging.rice-mono.local:6443"

# Production cluster
PROD_CLUSTER_ENDPOINT="https://prod.rice-mono.local:6443"

# Local cluster
LOCAL_CLUSTER_ENDPOINT="https://127.0.0.1:6443"

# ============================================================================
# Certificate-Based Authentication
# ============================================================================
# Base64 encoded CA certificate
CA_CERT_BASE64=""

# Base64 encoded client certificate
CLIENT_CERT_BASE64=""

# Base64 encoded client key
CLIENT_KEY_BASE64=""

# Or use file paths (uncomment to use)
# CA_CERT_PATH="/path/to/ca.crt"
# CLIENT_CERT_PATH="/path/to/client.crt"
# CLIENT_KEY_PATH="/path/to/client.key"

# ============================================================================
# Service Account Token
# ============================================================================
SERVICE_ACCOUNT_TOKEN=""

# ============================================================================
# OIDC Authentication (Production)
# ============================================================================
OIDC_ISSUER_URL="https://auth.rice-mono.com"
OIDC_CLIENT_ID="rice-mono"
OIDC_CLIENT_SECRET=""
OIDC_REFRESH_TOKEN=""
OIDC_ID_TOKEN=""

# ============================================================================
# AWS EKS Configuration
# ============================================================================
AWS_CLUSTER_NAME="rice-mono-cluster"
AWS_REGION="us-east-1"
AWS_PROFILE="rice-mono"
AWS_ACCOUNT_ID=""

# AWS IAM Role ARN for EKS access
AWS_ROLE_ARN="arn:aws:iam::ACCOUNT_ID:role/rice-mono-eks-admin"

# ============================================================================
# Google Cloud GKE Configuration
# ============================================================================
GCP_CLUSTER_NAME="rice-mono-cluster"
GCP_REGION="us-central1"
GCP_PROJECT="rice-mono"
GCP_ZONE="us-central1-a"

# GCP Service Account
GCP_SERVICE_ACCOUNT=""

# ============================================================================
# Azure AKS Configuration
# ============================================================================
AZURE_CLUSTER_NAME="rice-mono-cluster"
AZURE_RESOURCE_GROUP="rice-mono-rg"
AZURE_SUBSCRIPTION_ID=""
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""

# Azure Server ID for authentication
AZURE_SERVER_ID=""

# ============================================================================
# Namespaces
# ============================================================================
NAMESPACE_DEV="rice-mono-dev"
NAMESPACE_STAGING="rice-mono-staging"
NAMESPACE_PROD="rice-mono-prod"
NAMESPACE_BACKEND="rice-mono-backend"
NAMESPACE_FRONTEND="rice-mono-frontend"
NAMESPACE_BOT="rice-mono-bot"
NAMESPACE_TOKEN="rice-mono-token"

# ============================================================================
# Service Accounts
# ============================================================================
SA_ADMIN="rice-mono-admin"
SA_DEPLOY="rice-mono-deploy"
SA_READONLY="rice-mono-readonly"

# ============================================================================
# Additional Configuration
# ============================================================================
# Default context to use
DEFAULT_CONTEXT="dev"

# Enable/disable TLS verification for local development
INSECURE_SKIP_TLS_VERIFY="false"

# Kubectl proxy port
KUBECTL_PROXY_PORT="8001"

# ============================================================================
# Monitoring & Logging
# ============================================================================
PROMETHEUS_ENDPOINT=""
GRAFANA_ENDPOINT=""
LOKI_ENDPOINT=""

# ============================================================================
# Registry Configuration
# ============================================================================
DOCKER_REGISTRY="docker.io/rice-mono"
DOCKER_USERNAME=""
DOCKER_PASSWORD=""

# ============================================================================
# Secrets Management
# ============================================================================
# Sealed Secrets
SEALED_SECRETS_CONTROLLER_NAME="sealed-secrets-controller"  # pragma: allowlist secret
SEALED_SECRETS_CONTROLLER_NAMESPACE="kube-system"  # pragma: allowlist secret

# External Secrets Operator
EXTERNAL_SECRETS_BACKEND="aws-secrets-manager"  # pragma: allowlist secret
EXTERNAL_SECRETS_REGION="us-east-1"  # pragma: allowlist secret

# Vault
VAULT_ADDR=""
VAULT_TOKEN=""

# ============================================================================
# ArgoCD Configuration
# ============================================================================
ARGOCD_NAMESPACE="argocd"
ARGOCD_SERVER=""
ARGOCD_USERNAME="admin"
ARGOCD_PASSWORD=""

# ArgoCD Git Repository
ARGOCD_REPO_URL="https://github.com/rice-mono/rice-mono.git"
ARGOCD_REPO_BRANCH="main"

# ============================================================================
# Feature Flags
# ============================================================================
ENABLE_SERVICE_MESH="false"
ENABLE_NETWORK_POLICIES="true"
ENABLE_POD_SECURITY_POLICIES="false"
ENABLE_ISTIO="false"
ENABLE_CHAOS_MESH="false"

# ============================================================================
# Backup Configuration
# ============================================================================
BACKUP_ENABLED="true"
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS="7"
BACKUP_S3_BUCKET=""

# ============================================================================
# Notes
# ============================================================================
# To generate base64 encoded certificates:
#   cat ca.crt | base64 -w 0
#   cat client.crt | base64 -w 0
#   cat client.key | base64 -w 0
#
# To get service account token:
#   kubectl create token <service-account-name> -n <namespace> --duration=87600h
#
# To get cluster info:
#   kubectl cluster-info
#
# For more information, see KUBECONFIG.md
