package workspace

// cue cmd embed — regenerated from repo files
emitFiles_hooks: [
		{
			path:    "lefthook.yml"
			content: #"""
# lefthook.yml
# Generated by: cue export infra/configs/lefthook.cue
# Do not edit manually — edit infra/configs/lefthook.cue instead

# ── global ────────────────────────────────────────────────
colors: true
no_tty: false
rc: .lefthook-local.yml   # local overrides — never commit this

# ── pre-commit ────────────────────────────────────────────
pre-commit:
  parallel: true
  commands:

    # ── MASON — CUE + Proto ───────────────────────────────
    cue-vet:
      glob: "infra/configs/*.cue"
      run: cue vet infra/configs/*.cue
      stage_fixed: false

    buf-lint:
      glob: "infra/schemas/*.proto"
      run: buf lint infra/schemas/*.proto
      stage_fixed: false

    taplo:
      glob: "**/*.toml"
      run: taplo fmt --check {staged_files}
      stage_fixed: true

    vale:
      glob: "infra/docs/**/*.md"
      run: vale {staged_files}
      stage_fixed: false

    # ── SMITH — Go + Elixir ───────────────────────────────
    gofmt:
      glob: "service/**/*.go"
      run: gofmt -l {staged_files}
      stage_fixed: true

    golangci:
      glob: "service/**/*.go"
      run: cd service && golangci-lint run ./...
      stage_fixed: false

    mix-format:
      glob: "service/**/*.{ex,exs}"
      run: cd service && mix format --check-formatted {staged_files}
      stage_fixed: true

    mix-credo:
      glob: "service/**/*.{ex,exs}"
      run: cd service && mix credo --strict
      stage_fixed: false

    # ── CLERK — Rust + Haskell + Zig ─────────────────────
    rustfmt:
      glob: "base/**/*.rs"
      run: rustfmt --check {staged_files}
      stage_fixed: true

    clippy:
      glob: "base/**/*.rs"
      run: cd base && cargo clippy -- -D warnings
      stage_fixed: false

    fourmolu:
      glob: "base/**/*.hs"
      run: fourmolu --mode check {staged_files}
      stage_fixed: true

    hlint:
      glob: "base/**/*.hs"
      run: cd base && hlint .
      stage_fixed: false

    zig-fmt:
      glob: "base/**/*.zig"
      run: zig fmt --check {staged_files}
      stage_fixed: true

    # ── SAGE — Python + Mojo ──────────────────────────────
    ruff-format:
      glob: "function/**/*.py"
      run: ruff format --check {staged_files}
      stage_fixed: true

    ruff-lint:
      glob: "function/**/*.py"
      run: ruff check {staged_files}
      stage_fixed: true

    basedpyright:
      glob: "function/**/*.py"
      run: cd function && basedpyright
      stage_fixed: false

    # ── BARD — TypeScript + Dart + Odin ──────────────────
    biome:
      glob: "frontend/browser/**/*.{ts,tsx,js,jsx}"
      run: cd frontend/browser && biome check --apply {staged_files}
      stage_fixed: true

    dart-format:
      glob: "frontend/**/*.dart"
      run: dart format --set-exit-if-changed {staged_files}
      stage_fixed: true

    dart-analyze:
      glob: "frontend/**/*.dart"
      run: cd frontend/screen && dart analyze
      stage_fixed: false

    odin-fmt:
      glob: "frontend/vendor/**/*.odin"
      run: odin fmt {staged_files}
      stage_fixed: true

    # ── CHIEF — .rice language ────────────────────────────
    rice-fmt:
      glob: "custom/**/*.rice"
      run: rice fmt {staged_files}
      stage_fixed: true

    # ── secrets — never commit plaintext ─────────────────
    trufflehog:
      run: trufflehog git file://. --only-verified --no-update
      stage_fixed: false

    sops-check:
      glob: "*.enc.env"
      run: sops --decrypt --dry-run {staged_files}
      stage_fixed: false

    no-secrets:
      run: >
        git diff --cached -p |
        grep -E "(api_key|secret|password|token|private_key)" &&
        echo "❌ possible secret in diff — use SOPS" && exit 1 || true
      stage_fixed: false

# ── commit-msg ────────────────────────────────────────────
commit-msg:
  commands:
    convco:
      run: convco check {1}   # enforce conventional commits

# ── pre-push ──────────────────────────────────────────────
pre-push:
  parallel: false   # sequential — each step feeds the next
  commands:

    # ── fast tests only — no integration ─────────────────
    cargo-test:
      glob: "base/**/*.rs"
      run: cd base && cargo test --lib
      stage_fixed: false

    zig-test:
      glob: "base/**/*.zig"
      run: cd base && zig build test
      stage_fixed: false

    go-test:
      glob: "service/**/*.go"
      run: cd service && go test ./... -short
      stage_fixed: false

    mix-test:
      glob: "service/**/*.{ex,exs}"
      run: cd service && mix test --exclude integration
      stage_fixed: false

    pytest:
      glob: "function/**/*.py"
      run: cd function && pytest test/ -x --ignore=test/integration
      stage_fixed: false

    vitest:
      glob: "frontend/browser/**/*.{ts,tsx}"
      run: cd frontend/browser && bun run vitest --run
      stage_fixed: false

    flutter-test:
      glob: "frontend/**/*.dart"
      run: cd frontend/screen && flutter test
      stage_fixed: false

    # ── buf breaking change check ─────────────────────────
    buf-breaking:
      glob: "infra/schemas/*.proto"
      run: buf breaking --against '.git#branch=main' infra/schemas/*.proto
      stage_fixed: false

    # ── secrets scan on full push ─────────────────────────
    trufflehog-full:
      run: trufflehog git file://. --only-verified --no-update
      stage_fixed: false

# ── post-merge ────────────────────────────────────────────
post-merge:
  commands:
    # regenerate all configs after merge — keeps kingdom in sync
    rice-pour:
      run: just pour
      stage_fixed: false






"""#
		}
,
		{
			path:    ".lefthook-local.yml"
			content: #"""
# .lefthook-local.yml — personal overrides, never commit
# skip slow checks locally — CI runs them all

pre-push:
  commands:
    flutter-test:
      skip: true    # slow on local — CI handles it
    trufflehog-full:
      skip: true    # slow — runs in pre-commit already






