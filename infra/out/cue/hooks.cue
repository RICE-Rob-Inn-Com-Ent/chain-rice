# .vale.ini
# Generated by: cue export infra/configs/vale.cue
# Do not edit manually — edit infra/configs/vale.cue instead
#
# Setup:
#   vale sync   — downloads all configured styles
#   vale infra/docs/   — lint all docs
#   vale README.md     — lint single file

# ── global ────────────────────────────────────────────────
StylesPath   = infra/docs/.vale/styles
MinAlertLevel = suggestion

# ── formats — what vale scans ─────────────────────────────
[formats]
mdx = md

# ── markup — how vale parses each format ──────────────────
[*.{md,mdx}]
BasedOnStyles  = Vale, Google, Microsoft, write-good, proselint
TokenIgnores   = (?s)```.*?```       # ignore code blocks
BlockIgnores   = (?s)\|.*?\|         # ignore tables

[*.{yaml,yml}]
BasedOnStyles  = Vale
BlockIgnores   = (?s)#.*?$           # ignore inline comments

[*.rst]
BasedOnStyles  = Vale, Google

# ── Vale built-in rules ───────────────────────────────────
[Vale]
Vocab = rice                         # custom vocab — see below

Vale.Avoid        = YES
Vale.Repetition   = YES
Vale.Spelling     = YES
Vale.Terms        = YES

# ── Google developer docs style ───────────────────────────
[Google]
Google.Acronyms          = suggestion
Google.Colons            = warning
Google.DateFormat        = suggestion
Google.Exclamation       = warning
Google.FirstPerson       = suggestion
Google.Headings          = warning
