			path:    "cliff.toml"
			content: #"""
# cliff.toml
# Generated by: cue export infra/configs/cliff.cue
# Do not edit manually — edit infra/configs/cliff.cue instead
#
# Usage:
#   git cliff                        — full changelog
#   git cliff --unreleased           — unreleased only
#   git cliff --unreleased --prepend CHANGELOG.md  ← rice audit gate

[changelog]
# ── header ────────────────────────────────────────────────
header = """
# Changelog

All notable changes to `.rice OS` are documented here.
Versioning follows [Semantic Versioning](https://semver.org).
Commits follow [Conventional Commits](https://conventionalcommits.org).

"""

# ── per-release body template (Tera) ──────────────────────
body = """
{% if version %}\
## [{{ version | trim_start_matches(pat="v") }}] — {{ timestamp | date(format="%Y-%m-%d") }}
{% else %}\
## [Unreleased]
{% endif %}\

{% for group, commits in commits | group_by(attribute="group") %}
### {{ group }}
{% for commit in commits %}
- {% if commit.scope %}**{{ commit.scope }}:** {% endif %}\
{{ commit.message | upper_first }}\
{% if commit.breaking %} ⚠ BREAKING{% endif %}\
 ([`{{ commit.id | truncate(length=7, end="") }}`]({{ commit.id }}))\
{% endfor %}
{% endfor %}\n
"""

# ── footer ────────────────────────────────────────────────
footer = """
---
*Generated by [git-cliff](https://git-cliff.org) — driven by [convco](https://convco.github.io)*
"""

trim = true

[git]
# ── what to parse ─────────────────────────────────────────
conventional_commits     = true
filter_unconventional    = true   # skip non-conventional commits
split_commits            = false
commit_preprocessors     = [
    # strip PR/issue refs from message — keeps changelog clean
    { pattern = '\(#([0-9]+)\)', replace = "" },
    # normalize whitespace
    { pattern = "  +", replace = " " },
]

# ── tag pattern ───────────────────────────────────────────
tag_pattern         = "v[0-9].*"
skip_tags           = "v0\\.0\\.1"    # skip bootstrap tag
ignore_tags         = ""
topo_order          = false
sort_commits        = "newest"

# ── commit parsers → changelog groups ─────────────────────
commit_parsers = [
    # ── breaking changes — always first ───────────────────
    { body = ".*BREAKING CHANGE.*",  group = "⚠ Breaking Changes" },
    { message = "^.*!:",             group = "⚠ Breaking Changes" },

    # ── .rice OS custom types ──────────────────────────────
    { message = "^rice",             group = " .rice Language" },
    { message = "^model",            group = " Models" },
    { message = "^infra",            group = " Infrastructure" },

    # ── standard types ────────────────────────────────────
    { message = "^feat",             group = " Features" },
    { message = "^fix",              group = " Bug Fixes" },
    { message = "^sec",              group = " Security" },
    { message = "^perf",             group = " Performance" },
    { message = "^refactor",         group = " Refactoring" },
    { message = "^revert",           group = " Reverts" },
    { message = "^test",             group = " Tests" },
    { message = "^build",            group = " Build" },
    { message = "^ci",               group = " CI" },
    { message = "^docs",             group = " Documentation" },
    { message = "^style",            group = " Style" },
    { message = "^chore",            group = " Chores" },

    # ── skip noise ────────────────────────────────────────
    { message = "^chore\\(release\\)", skip = true },
    { message = "^chore\\(deps\\)",    skip = true },
    { message = "^chore\\(pr\\)",      skip = true },
    { message = "^chore\\(pull\\)",    skip = true },
    { message = "^Merge",              skip = true },
    { message = "^wip",                skip = true },
    { message = "^WIP",                skip = true },
]

# ── scope filter — only known scopes ──────────────────────
# matches convco.toml scopes
filter_commits = false   # set true to hard-reject unknown scopes

# ── link parsers — linkify refs ───────────────────────────
link_parsers = [
    { pattern = "#([0-9]+)", href = "https://github.com/mrDinkelman/rice/issues/$1" },
    { pattern = "RFC ([0-9]+)", text = "RFC-$1", href = "https://github.com/mrDinkelman/rice/discussions/$1" },
]

[bump]
# ── semver bump rules — derived from commit types ─────────
features_always_bump_minor = true
breaking_always_bump_major = true
initial_tag                = "0.1.0"

# custom bump rules per type
custom_major_increment_regex = "^(rice|feat)!:"
custom_minor_increment_regex = "^(feat|rice):"






