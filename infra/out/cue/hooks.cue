# convco.toml
# Generated by: cue export infra/configs/convco.cue
# Do not edit manually — edit infra/configs/convco.cue instead

[commit]
    # enforce conventional commit format on every commit
    # format: <type>(<scope>): <description>
    sign_off = false           # no DCO sign-off required
    gpg_sign = false           # flip to true when GPG key is configured

[types]
    # allowed commit types — maps to changelog sections
    # format: type = { description, changelog_section, bump }
    # bump: major | minor | patch | none

    [types.feat]
        description       = "a new feature"
        changelog_section = "Features"
        bump              = "minor"

    [types.fix]
        description       = "a bug fix"
        changelog_section = "Bug Fixes"
        bump              = "patch"

    [types.perf]
        description       = "a performance improvement"
        changelog_section = "Performance"
        bump              = "patch"

    [types.refactor]
        description       = "a code change that neither fixes a bug nor adds a feature"
        changelog_section = "Refactoring"
        bump              = "none"

    [types.revert]
        description       = "reverts a previous commit"
        changelog_section = "Reverts"
        bump              = "patch"

    [types.test]
        description       = "adding or correcting tests"
        changelog_section = "Tests"
        bump              = "none"

    [types.build]
        description       = "changes that affect the build system or external dependencies"
        changelog_section = "Build"
        bump              = "none"

    [types.ci]
        description       = "changes to CI configuration files and scripts"
        changelog_section = "CI"
        bump              = "none"

    [types.docs]
        description       = "documentation only changes"
        changelog_section = "Documentation"
        bump              = "none"

    [types.style]
        description       = "changes that do not affect the meaning of the code"
        changelog_section = "Style"
        bump              = "none"

    [types.chore]
        description       = "other changes that do not modify src or test files"
        changelog_section = "Chores"
        bump              = "none"

    [types.sec]
        description       = "a security fix or hardening change"
        changelog_section = "Security"
        bump              = "patch"

    [types.rice]
        description       = ".rice language or compiler change"
        changelog_section = ".rice"
        bump              = "minor"

    [types.model]
        description       = "LoRA adapter or model registry change"
        changelog_section = "Models"
        bump              = "none"

    [types.infra]
        description       = "infrastructure or platform change"
        changelog_section = "Infrastructure"
        bump              = "none"

[scopes]
    # allowed scopes — maps to monorepo roles and domains
    # enforced on commit — unknown scope is rejected
    allowed = [
        # roles
        "king",
        "mason",
        "smith",
        "clerk",
        "sage",
        "bard",
        "chief",
        # domains
        "mint",        # .rice compiler
        "infra",       # CUE + Proto + docs
        "service",     # Go + Elixir
        "base",        # Rust + Haskell + Zig
        "frontend",    # Odin + TypeScript + Dart
        "function",    # Python + Mojo
        "custom",      # user projects
        # cross-cutting
        "deps",        # dependency updates
        "config",      # config file changes
        "k8s",         # Kubernetes manifests
        "ci",          # CI pipeline changes
        "release",     # release process
        "model",       # AI model / LoRA changes
    ]

[breaking]
    # BREAKING CHANGE in footer → major version bump
    # or ! after type: feat!: redesign .rice syntax
    token     = "BREAKING CHANGE"
    bump      = "major"

[changelog]
    # git-cliff drives changelog — convco feeds commit metadata
    # output: CHANGELOG.md — prepended by rice audit → _audit-gate
    output = "CHANGELOG.md"

    [changelog.git]
        # include merge commits in changelog
        filter_unconventional = true
        # sort commits by newest first within section
        sort_commits          = "newest"

    [changelog.sections]
        # order of sections in CHANGELOG.md
        order = [
            "Features",
            "Bug Fixes",
            "Security",
            "Performance",
            ".rice",
            "Models",
            "Infrastructure",
            "Build",
            "Refactoring",
            "Reverts",
            "Tests",
            "Documentation",
            "CI",
            "Style",
            "Chores",
        ]

[version]
    # semver — derived from commit history
    # initial version if no tags exist
    initial = "0.1.0"
    # tag prefix
    prefix  = "v"
    # bump rules already defined per type above
    # manual override: convco version --bump major|minor|patch






"""#
		}
]
