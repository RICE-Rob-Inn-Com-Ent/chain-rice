  // === Other Tools ===
  "quokka.automaticRestart": true,
  "rust-analyzer.workspace.discoverConfig": null,
  "redhat.telemetry.enabled": true,
  "vsicons.dontShowNewVersionMessage": true,
  "vs-kubernetes": {
    "vscode-kubernetes.kubectl-path-linux": "/home/mrDinkelman/.local/state/vs-kubernetes/tools/kubectl/kubectl",
    "vscode-kubernetes.helm-path-linux": "/home/mrDinkelman/.local/state/vs-kubernetes/tools/helm/linux-amd64/helm",
    "vscode-kubernetes.minikube-path-linux": "/home/mrDinkelman/.local/state/vs-kubernetes/tools/minikube/linux-amd64/minikube"
