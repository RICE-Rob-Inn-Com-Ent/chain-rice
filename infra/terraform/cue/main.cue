  kubernetes {
    config_path = local.kubeconfig
  }
}

provider "kubectl" {
  config_path = local.kubeconfig
}

locals {
  enable_aws   = contains(var.rice_enabled_clouds, "aws")
  enable_gcp   = contains(var.rice_enabled_clouds, "gcp")
  enable_azure = contains(var.rice_enabled_clouds, "azure")
}

provider "aws" {
  region = var.rice_aws_region

  dynamic "assume_role" {
    for_each = var.rice_aws_assume_role_arn != "" ? [1] : []
