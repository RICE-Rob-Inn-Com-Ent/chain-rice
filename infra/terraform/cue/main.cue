      role_arn = var.rice_aws_assume_role_arn
    }
  }
}

provider "google" {
  project               = var.rice_gcp_project_id
  region                = var.rice_gcp_region
  user_project_override = true
}

provider "azurerm" {
  features {}

  subscription_id = var.rice_azure_subscription_id != "" ? var.rice_azure_subscription_id : null
  tenant_id       = var.rice_azure_tenant_id != "" ? var.rice_azure_tenant_id : null
}
