# Rebuild: buck2 build '//infra/proto:check'

genrule(
    name = "check",
    srcs = glob(["cue/*.cue", "buf.yaml", "buf.gen.yaml", "DIAGRAM.puml"]),
    out = "check.stamp",
    cmd = """
set -euo pipefail
REPO=$(git rev-parse --show-toplevel)
export PATH="$REPO/.pixi/envs/default/bin:/usr/local/bin:/usr/bin:$HOME/.local/bin:$PATH"
cd "$REPO"
cue vet ./infra/proto/cue/...
